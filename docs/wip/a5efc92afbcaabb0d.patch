+    await expect(collecter(ecrireZip([{ chemin: "x", contenu: { flux: (async function* () { /* jamais lu */ })(), taille: 4 * 1024 ** 3 } }], "stocke"))).rejects.toBeInstanceOf(ErreurZipLimite);
+    expect(LIMITE_ZIP_OCTETS).toBeLessThan(4 * 1024 ** 3);
+  });
