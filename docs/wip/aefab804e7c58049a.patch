+  }, 60_000);
+
+  it("LES REFUS RESTENT, et un refus ne ferme RIEN : sans motif, par un collègue, par un autre module, argent parti, poste qui engage la dépense", async () => {
+    const spo = await nouveauSponsoring("À refuser");
