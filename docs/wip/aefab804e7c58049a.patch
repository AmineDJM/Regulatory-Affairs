+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import type { CurrentUser } from "@/lib/session";
+
+vi.mock("next/cache", () => ({ revalidatePath: () => {} }));
+let ACTOR: CurrentUser | null = null;
