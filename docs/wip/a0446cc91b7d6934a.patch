+    ...docs.map((d) => d.fileKey),
+    ...recs.flatMap((r) => ((r.documents as { fileKey?: string | null }[] | null) ?? []).map((x) => x.fileKey)),
+  ].filter((k): k is string => Boolean(k)));
+}
