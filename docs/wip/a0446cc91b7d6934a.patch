+    const m3 = ctd.dossiers.find((d) => d.nom === "Module 3")!;
+    expect(m3.nbFichiers).toBe(1);
+    expect(m3.dossiers[0].chemin).toBe("CTD/Module 3/3.2.P");
+  });
