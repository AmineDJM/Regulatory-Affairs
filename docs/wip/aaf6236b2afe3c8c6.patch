+
+  it("le chargeur des pièces liées et celui de la demande lisent LA décision partagée — jamais une recopie", () => {
+    for (const rel of ["src/lib/queries/pieces-legal-demande.ts", "src/lib/queries/chaine-des-pieces.ts"]) {
