{
  "name": "amd-internal-os",
  "version": "0.1.0",
  "private": true,
  "description": "AMD Internal OS — lightweight internal ERP for Adventum Pharma",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:reset": "prisma migrate reset --force",
    "graphify:refresh": "bash scripts/graphify-refresh.sh",
    "graphify:report": "cat graphify-out/GRAPH_REPORT.md",
    "graphify:query": "bash scripts/graphify-query.sh"
  },
  "prisma": {
    "seed": "tsx prisma/bootstrap.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "imapflow": "^1.4.3",
    "jszip": "^3.10.1",
    "lucide-react": "0.446.0",
    "mailparser": "^3.9.12",
    "mammoth": "^1.12.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.22",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "tailwind-merge": "2.5.2",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "20.16.10",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.2"
  }
}
