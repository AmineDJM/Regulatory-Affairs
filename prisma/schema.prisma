// ─────────────────────────────────────────────────────────────────────────────
// AMD Internal OS — Prisma schema
// Lightweight internal ERP for Adventum Pharma.
//
// Conventions
//  - Every business model carries audit fields: createdAt, updatedAt,
//    createdById, updatedById (scalar user ids; rich history lives in AuditLog).
//  - Row-level access is driven by explicit ownership/assignment relations
//    (e.g. RegulatoryProduct.assignedUsers, MedicalDoctor.delegate).
//  - Files & comments are polymorphic via (entityType, entityId).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

