// ─────────────── Business Development : Projet → Gamme → Produit ───────────────
// Tableau stratégique : un projet regroupe des gammes, chaque gamme des produits
// (DCI) porteurs des données marché / investissement / revenus. Modèle simple et
// granulaire (pas un CRM lourd) ; tout est saisi manuellement par l'équipe.

model BdProject {
  custom      Json? // champs dynamiques définis par l'admin
  id          String          @id @default(cuid())
  name        String
  status      BdProjectStatus @default(IDEA)
  description String?
  comment     String?

  ownerId String?
  owner   User?     @relation("BdProjectOwner", fields: [ownerId], references: [id])
  ranges  BdRange[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

