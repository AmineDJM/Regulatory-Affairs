// ───────────────────────────── Core / identity ─────────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  adminRequests AdministrativeRequest[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(VIEWER)
  title        String? // job title
  phone        String?
  avatarColor  String? // UI accent for the avatar chip
  isActive     Boolean   @default(true)
  region       String? // for medical delegates / sales
  lastLoginAt  DateTime?
  lastSeenAt   DateTime? // présence messagerie (heartbeat) : « en ligne / actif il y a… »

  // Auth hardening: bump tokenVersion to invalidate all existing JWTs;
  // force a password change on next login.
  tokenVersion       Int     @default(0)
  mustChangePassword Boolean @default(false)

  // Onboarding guidé : déclenché à la création d'un compte ou redéclenché par le
  // Super Admin (« demander le setup à la prochaine connexion »). Vérifié à chaud
  // (lecture BDD) par le layout, jamais via le JWT — pas de re-login nécessaire.
  mustOnboard Boolean   @default(false)
  onboardedAt DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Functional relations (drive row-level access)
  regulatoryAsResponsible RegulatoryProduct[]              @relation("RegulatoryResponsible")
  regulatoryAsAssistant   RegulatoryProduct[]              @relation("RegulatoryAssistant")
  assignedRegulatory      RegulatoryProduct[]              @relation("RegulatoryAssignedUsers")
  sponsoringRequests      SponsoringRequest[]
  sales                   Sale[]
  doctors                 MedicalDoctor[]
  visits                  MedicalVisit[]
  delegatePlans           MedicalDelegatePlan[]
  bdOpportunities         BusinessDevelopmentOpportunity[]
  bdProjects              BdProject[]                      @relation("BdProjectOwner")
  budgetLines             BudgetLine[]
  logisticsOrders         LogisticsOrder[]

  notifications Notification[]
  auditLogs     AuditLog[]
  comments      Comment[]
  documents     Document[]

  // Admin-managed dynamic access + activity + sessions
  access       UserAccess[]
  rowGrants    RowGrant[]
  sessions     UserSession[]
  activityLogs ActivityLog[]

  // RH & espace de travail
  employee         Employee?       @relation("UserEmployee")
  tasksAssigned    Task[]          @relation("TaskAssignee")
  tasksCreated     Task[]          @relation("TaskCreator")
  leaveDecisions   LeaveRequest[]  @relation("LeaveDecider")
  advanceDecisions SalaryAdvance[] @relation("AdvanceDecider")
  expenseOrders    ExpenseOrder[]  @relation("ExpenseOrderRequester")
  driveNodes       DriveNode[]     @relation("DriveOwner")
  driveShares      DriveShare[]    @relation("DriveShareUser")

  // Demandes administratives
  adminRequests           AdministrativeRequest[] @relation("ReqRequester")
  adminRequestsConcerned  AdministrativeRequest[] @relation("ReqConcerned")
  adminRequestsAssigned   AdministrativeRequest[] @relation("ReqAssignee")
  adminRequestsValidating AdministrativeRequest[] @relation("ReqValidator")
  adminApprovals          AdminApproval[]         @relation("ApprovalValidator")
  driverMissions          DriverMission[]         @relation("MissionDriver")

  // Validations transversales + feedback
  validationRequests ValidationRequest[] @relation("ValidationRequester")
  validationSteps    ValidationStep[]    @relation("ValidationStepValidator")
  feedbacks          Feedback[]          @relation("UserFeedback")

  // Messagerie interne
  conversationsCreated Conversation[]       @relation("ConvCreator")
  convMemberships      ConversationMember[] @relation("ConvMemberUser")
  messagesSent         Message[]            @relation("MessageSender")
  messageReactions     MessageReaction[]    @relation("ReactionUser")
  messageMentions      MessageMention[]     @relation("MentionUser")
  messageBookmarks     MessageBookmark[]    @relation("BookmarkUser")

  // Rapports terrain (vocaux) des délégués
  fieldReports FieldReport[] @relation("FieldReportDelegate")

  // Événements organisés
  eventsResponsible Event[] @relation("EventResponsible")

  // Boîte mail personnelle connectée (Infomaniak IMAP/SMTP)
  mailAccount MailAccount? @relation("UserMailAccount")

  // Information médicale (déclaration réglementaire)
  medicalInfoDeclarations MedicalInfoDeclaration[] @relation("MedicalInfoPharmacist")
  medicalInfoDocRequests  MedicalInfoDocRequest[]  @relation("MedicalInfoDocTarget")

  // Directives (Direction → équipes)
  directivesReceived  Directive[]        @relation("DirectiveTarget")
  directivesAuthored  Directive[]        @relation("DirectiveAuthor")
  directiveMessages   DirectiveMessage[] @relation("DirectiveMsgAuthor")

  // Demandes de support (→ directeur médical / chef de produit)
  supportRequested  SupportRequest[] @relation("SupportRequester")
  supportTargeted   SupportRequest[] @relation("SupportTarget")
  supportAssigned   SupportRequest[] @relation("SupportAssignee")
  supportMessages   SupportMessage[] @relation("SupportMsgAuthor")

  // Dossiers de suivi (sujets délégués / suivis)
  dossiersCreated  Dossier[]        @relation("DossierCreator")
  dossiersAssigned Dossier[]        @relation("DossierAssignee")
  dossierMessages  DossierMessage[] @relation("DossierMsgAuthor")

  @@index([role])
  @@index([departmentId])
}

/// Boîte mail personnelle d'un employé (Infomaniak), connectée à la plateforme.
/// Le mot de passe d'application est chiffré (AES-256-GCM) ; IMAP (lecture) + SMTP
/// (envoi) côté serveur uniquement. Un compte par utilisateur.
model MailAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation("UserMailAccount", fields: [userId], references: [id], onDelete: Cascade)
  email       String // adresse e-mail (login IMAP/SMTP)
  displayName String? // nom affiché à l'envoi
  imapHost    String   @default("mail.infomaniak.com")
  imapPort    Int      @default(993)
  smtpHost    String   @default("mail.infomaniak.com")
  smtpPort    Int      @default(465)
  passwordEnc String // mot de passe d'application, chiffré (jamais en clair)
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────── Regulatory ─────────────────────────────

model RegulatoryProduct {
  custom             Json? // admin-defined dynamic fields
  id                 String             @id @default(cuid())
  reference          String             @unique // human readable ID, e.g. REG-2026-001
  dci                String // molecule / active ingredient
  brandName          String? // nom commercial envisagé
  dosage             String?
  pharmaceuticalForm String?
  therapeuticClass   String?
  partnerLab         String? // fournisseur / laboratoire partenaire
  countryOfOrigin    String?
  category           RegulatoryCategory @default(MEDICINE) // médicament vs dispositif médical
  productType        ProductType        @default(IMPORTED)
  status             RegulatoryStatus   @default(PRE_SUBMISSION)
  priority           Priority           @default(MEDIUM)
  targetDate         DateTime? // date cible d'enregistrement
  comments           String?

  responsibleId String?
  responsible   User?   @relation("RegulatoryResponsible", fields: [responsibleId], references: [id])
  assistantId   String?
  assistant     User?   @relation("RegulatoryAssistant", fields: [assistantId], references: [id])
  // Row-level access: only these users (plus privileged roles) see the line.
  assignedUsers User[]  @relation("RegulatoryAssignedUsers")

  steps RegulatoryStep[]

  // ─── Vue fournisseur (portail externe) — pilotée par l'équipe Regulatory ───
  // Le fournisseur ne voit QUE ces champs externes, jamais le statut/les notes
  // internes, et uniquement si portalVisible = true.
  supplierId             String?
  supplier               Supplier?                 @relation(fields: [supplierId], references: [id])
  portalVisible          Boolean                   @default(false)
  externalStatus         ExternalRegulatoryStatus?
  externalComment        String?
  externalNextStep       String?
  externalActionExpected String?
  externalDeadline       DateTime?
  externalNotify         Boolean                   @default(false)
  externalUpdatedAt      DateTime?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([responsibleId])
  @@index([assistantId])
  @@index([dci])
  @@index([supplierId])
}

model RegulatoryStep {
  id          String             @id @default(cuid())
  productId   String
  product     RegulatoryProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        RegulatoryStepType
  order       Int
  status      StepStatus         @default(NOT_STARTED)
  plannedDate DateTime?
  actualDate  DateTime?
  responsible String?
  comment     String?
  missingDocs String? // pièces manquantes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, type])
  @@index([productId])
  @@index([status])
}

// ───────────────────────────── Sponsoring ─────────────────────────────

model SponsoringRequest {
  custom              Json? // admin-defined dynamic fields
  id                  String           @id @default(cuid())
  reference           String           @unique
  requestDate         DateTime         @default(now())
  requesterId         String?
  requester           User?            @relation(fields: [requesterId], references: [id])
  institution         String // institution / service / association
  doctor              String? // médecin concerné
  specialty           String?
  city                String?
  type                String // type de sponsoring
  description         String?
  amountRequested     Decimal?         @db.Decimal(12, 2)
  amountProposed      Decimal?         @db.Decimal(12, 2)
  amountGranted       Decimal?         @db.Decimal(12, 2)
  status              SponsoringStatus @default(RECEIVED)
  strategicImportance Priority         @default(MEDIUM)
  product             String? // produit concerné
  expectedRoi         String?
  finalDecision       String? // commentaire final de la Direction (visible par le délégué)
  validatedBy         String?
  validationDate      DateTime?
  comments            String? // appréciation / recommandation du délégué

  // Circuit de validation (calqué sur les congrès) — préliminaire (Direction) →
  // analyse chef de produit (avis + budget proposé, CONFIDENTIELS vis-à-vis du délégué)
  // → décision définitive (Direction : budget final + commentaire) → appel possible.
  preliminaryById      String?
  preliminaryAt        DateTime?
  preliminaryNote      String? // note interne de pré-validation (non visible par le délégué)
  productManagerId     String?
  productManagerBudget Decimal?  @db.Decimal(12, 2) // budget proposé par le chef de produit — CONFIDENTIEL
  productManagerNotes  String? // avis du chef de produit — CONFIDENTIEL (jamais montré au délégué)
  finalById            String?
  finalAt              DateTime?
  expenseOrderId       String? // ordre de dépense émis à la validation définitive
  appealById           String?
  appealAt             DateTime?
  appealReason         String? // motif de l'appel du délégué
  appealCount          Int       @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([strategicImportance])
  @@index([requesterId])
  @@index([productManagerId])
}

// ───────────────────────────── Budgets ─────────────────────────────

model BudgetLine {
  custom          Json? // admin-defined dynamic fields
  id              String         @id @default(cuid())
  year            Int
  month           Int? // 1-12, null = annual line
  department      BudgetCategory
  label           String // ligne budgétaire
  initialBudget   Decimal        @default(0) @db.Decimal(14, 2)
  consumedBudget  Decimal        @default(0) @db.Decimal(14, 2)
  futureCommitted Decimal        @default(0) @db.Decimal(14, 2)
  status          BudgetStatus   @default(ON_TRACK)
  comments        String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@index([department])
  @@index([status])
}

// Enveloppe budgétaire : un budget TOTAL défini par la Direction pour une période,
// réparti en catégories (BudgetCategoryLine). La consommation est calculée à partir
// des dépenses réelles (FinanceTransaction OUT) attribuées à chaque catégorie.
model BudgetEnvelope {
  id          String               @id @default(cuid())
  name        String
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Decimal              @default(0) @db.Decimal(14, 2)
  notes       String?
  isActive    Boolean              @default(true)
  categories  BudgetCategoryLine[]
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isActive])
  @@index([periodStart])
}

// Catégorie créée par la Direction au sein d'une enveloppe, avec son allocation.
model BudgetCategoryLine {
