/// RAPPEL personnel « en un clic » posé sur n'importe quel sujet (dossier réglementaire, demande du
/// secrétariat, e-mail, tâche, ou libre). À l'échéance (remindAt), un job planifié notifie le
/// propriétaire. link/entityType/entityId renvoient vers l'objet concerné.
model Reminder {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation("UserReminders", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  note        String?
  link        String?
  entityType  EntityType?
  entityId    String?
  remindAt    DateTime
  status      ReminderStatus @default(PENDING)
  sentAt      DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, status])
  @@index([status, remindAt])
}

enum ReminderStatus {
  PENDING
  SENT
  DONE
  CANCELLED
}

/// Boîte mail personnelle d'un employé (Infomaniak), connectée à la plateforme.
/// Le mot de passe d'application est chiffré (AES-256-GCM) ; IMAP (lecture) + SMTP
/// (envoi) côté serveur uniquement. Un compte par utilisateur.
model MailAccount {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation("UserMailAccount", fields: [userId], references: [id], onDelete: Cascade)
  email       String // adresse e-mail (login IMAP/SMTP)
  displayName String? // nom affiché à l'envoi
  signature   String?   @db.Text // signature ajoutée en bas des nouveaux messages (webmail)
  imapHost    String    @default("mail.infomaniak.com")
  imapPort    Int       @default(993)
  smtpHost    String    @default("mail.infomaniak.com")
  smtpPort    Int       @default(465)
  passwordEnc String // mot de passe d'application, chiffré (jamais en clair)
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// ───────────────────────── Messagerie Microsoft 365 ─────────────────────────
/// Microsoft reste la SOURCE DE VÉRITÉ des e-mails. PostgreSQL ne garde que ce qui permet de
/// fonctionner : la connexion de la personne, ses jetons CHIFFRÉS, les jetons de synchronisation
/// incrémentale, et les liens vers l'ERP. Aucun corps de message, aucune pièce jointe.

/// La connexion d'UNE personne à SA boîte Exchange Online. Une par utilisateur — l'isolation est
/// structurelle : toute requête part de `userId`, jamais d'un identifiant reçu de l'extérieur.
model MailConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation("UserMailConnection", fields: [userId], references: [id], onDelete: Cascade)
  provider        String    @default("microsoft")
  /// Adresse de la boîte servie (minuscule) — sert à l'affichage et au contrôle du pilote.
  address         String
  displayName     String?
  /// Identifiant du compte chez Microsoft — permet de détecter un changement de compte.
  homeAccountId   String?
  /// Jetons chiffrés AES-256-GCM. Jamais rendus au navigateur, jamais journalisés.
  accessTokenEnc  String?   @db.Text
  refreshTokenEnc String?   @db.Text
  expiresAt       DateTime?
  /// Droits réellement accordés par Microsoft — un consentement partiel doit se voir.
  grantedScopes   String?   @db.Text
  /// Signature HTML ajoutée aux nouveaux messages.
  signature       String?   @db.Text
  /// `connected` | `needs-reconnect` — l'écran doit distinguer « en panne » de « à reconnecter ».
  status          String    @default("connected")
  lastError       String?
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  folders MailFolderState[]
  links   MailLink[]
}

/// État de synchronisation d'UN dossier : le jeton de delta et les compteurs. Pas les messages.
model MailFolderState {
  id            String         @id @default(cuid())
  connectionId  String
  connection    MailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  folderId      String
  displayName   String?
  wellKnown     String?
  /// Jeton de delta CHIFFRÉ : il vaut un droit de lecture sur le dossier chez Microsoft.
  deltaTokenEnc String?        @db.Text
  unread        Int            @default(0)
  total         Int            @default(0)
  lastSyncAt    DateTime?
  updatedAt     DateTime       @updatedAt

  @@unique([connectionId, folderId])
}

/// Ce qui relie un mail (ou une de ses pièces) à l'ERP : un fichier enregistré dans le Drive, un
/// message associé à un produit Regulatory… On garde l'identifiant Microsoft, jamais le contenu.
model MailLink {
  id            String         @id @default(cuid())
  connectionId  String
  connection    MailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messageId     String
  /// Pièce jointe concernée, quand le lien en vise une.
  attachmentId  String?
  /// Provenance conservée pour l'audit : qui a écrit, quand, et quel objet.
  senderAddress String?
  sentAt        DateTime?
  subject       String?
  /// Objet ERP associé (`REGULATORY_PRODUCT`, `DOSSIER`, `SUPPLIER`…) — vide si simple copie Drive.
  entityType    String?
  entityId      String?
  /// Nœud Drive créé par « Enregistrer dans Drive ».
  driveNodeId   String?
  createdById   String
  createdAt     DateTime       @default(now())

  @@index([connectionId, messageId])
  @@index([entityType, entityId])
}

// ───────────────────────────── Regulatory ─────────────────────────────

/// Entité juridique / société du groupe (Adventum Pharma, Pharmagène, …). Dimension
/// TRANSVERSE : chaque enregistrement clé (produit, appel d'offres, employé, dépense,
/// vente, stock…) peut être rattaché à une entité. Le sélecteur d'entité (barre
/// supérieure) filtre toutes les vues ; « Toutes les entités » englobe l'ensemble
/// (y compris les non rattachés). Entièrement DYNAMIQUE : on peut créer une 3ᵉ (ou Nᵉ)
/// entité, la renommer, changer sa couleur, la désactiver — sans toucher au code.
/// QUI A LE DROIT DE VOIR QUELLE ENTITÉ.
///
/// Le sélecteur d'entité de la barre supérieure n'était qu'une **préférence d'affichage** : il
/// proposait toutes les entités à tout le monde, et rien n'empêchait quelqu'un d'Adventum de
/// basculer sur Pharmagène. Pour un groupe multi-entités c'est un défaut d'étanchéité, pas un
/// confort d'affichage.
///
/// Une personne peut être salariée d'une entité et travailler pour plusieurs : l'appartenance
/// (`Employee.companyId`) et le DROIT D'ACCÈS sont deux choses distinctes.
///
/// `canEdit` sépare voir et modifier : on donne souvent la lecture sur une entité voisine sans
/// le droit d'y écrire.
model UserCompanyAccess {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  canEdit   Boolean @default(false)

  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique // raison sociale (« Adventum Pharma »)
  shortName   String? // libellé court affiché dans les pastilles (« Adventum »)
  color       String? // couleur de la pastille (hex, ex. « #2563eb »)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regulatoryProducts      RegulatoryProduct[]
  pchTenders              PchTender[]
  employees               Employee[]
  promoMaterials          PromoMaterial[]
  consultingContracts     ConsultingContract[]
  adProOtherRequests      AdProOtherRequest[]
  paymentRequests         PaymentRequest[]
  promoStockItems         PromoStockItem[]
  medicalDoctors          MedicalDoctor[]
  financeTransactions     FinanceTransaction[]
  medicalInfoDeclarations MedicalInfoDeclaration[]
  stockSnapshots          StockSnapshot[]
  logisticsOrders         LogisticsOrder[]
  sales                   Sale[]
  businessUnits           BusinessUnit[]
  departments             Department[]
  userAccess              UserCompanyAccess[]
  // Cloisonnement transverse : chaque demande, enveloppe et ordre de dépense appartient à
  // une société du groupe. Nullable côté enfant — un objet non rattaché reste visible en
  // vue « Toutes les entités » plutôt que de disparaître.
  sponsoringRequests      SponsoringRequest[]
  congressNational        CongressNational[]
  congressInternational   CongressInternational[]
  events                  Event[]
  budgetEnvelopes         BudgetEnvelope[]
  expenseOrders           ExpenseOrder[]
  administrativeRequests  AdministrativeRequest[]
  supportRequests         SupportRequest[]
  dossiers                Dossier[]
  fieldReports            FieldReport[]
  Training                Training[]

  @@index([isActive])
}

model RegulatoryProduct {
  companyId              String? // entité (Adventum / Pharmagène / …)
  company                Company?            @relation(fields: [companyId], references: [id])
  custom                 Json? // admin-defined dynamic fields
  // Suivi du processus officiel ANPP (22 étapes) et de la checklist de présoumission.
  // Stockés en JSON (définition des étapes/documents en code) : { [clé]: { status/checked, date, note } }.
  workflow               Json?
  checklist              Json?
  id                     String              @id @default(cuid())
  reference              String              @unique // human readable ID, e.g. REG-2026-001
  dci                    String // DCI canonique : molécule unique OU association (« A + B + C »)
  molecules              Json? // liste structurée des molécules (association double/triple…)
  brandName              String? // nom commercial envisagé
  dosage                 String? // valeur du dosage (ex. « 500 »)
  dosageUnit             String? // unité du dosage (mg, g, UI, %, mg/ml…)
  pharmaceuticalForm     String? // forme galénique (menu déroulant)
  // Conditionnement (« B/30 », « Tube 30 G ») : à dosage et forme identiques, c'est LUI qui
  // distingue deux dossiers — une boîte de 28 et une boîte de 56 sont deux enregistrements.
  packaging              String?
  therapeuticClass       String?
  /// SEGMENTS THÉRAPEUTIQUES — Oncologie, Gynécologie, Cardiologie…
  /// Une LISTE et non un texte : un produit sert souvent plusieurs segments, et « Oncologie,
  /// Gynéco » écrit à la main ne se compte ni ne se filtre. La classe thérapeutique reste, en
  /// texte : elle dit la classe pharmacologique, pas le marché visé.
  therapeuticSegments    String[]            @default([])
  partnerLab             String? // fournisseur / laboratoire partenaire
  countryOfOrigin        String?
  category               RegulatoryCategory  @default(MEDICINE) // médicament vs dispositif médical
  channel                ProductChannel      @default(BOTH) // canal : Ville / Hôpital / les deux
  productType            ProductType         @default(IMPORTED) // (legacy) conservé, non affiché
  // Statut de fabrication courant : démarre en Importation, évolue via les variations.
  manufacturingStatus    ManufacturingStatus @default(IMPORTATION)
  status                 RegulatoryStatus    @default(PRE_SUBMISSION)
  priority               Priority            @default(MEDIUM)
  targetSubmissionDate   DateTime? // date cible de dépôt du dossier (fixée par la supervision)
  targetDate             DateTime? // date cible d'enregistrement (fixée après le dépôt)
  comments               String?
  // Décision d'enregistrement : détenteur de la DE, et variation d'enregistrement
  // vers la fabrication locale (packaging secondaire / primaire / full process).
  // Si une variation locale est déclarée, le fabricant est OBLIGATOIRE.
  deHolder               String? // détenteur de la décision d'enregistrement
  manufacturingVariation String? // NONE | SECONDARY_PACKAGING | PRIMARY_PACKAGING | FULL_PROCESS
  manufacturer           String? // fabricant (obligatoire si variation locale)
  variationDate          DateTime? // date d'effet de la variation

  /// VERROU — dossier invisible pour toute l'équipe, y compris la Direction. Seul le Super
  /// Admin le voit et peut le déverrouiller (cadenas du tableau). Sert aux portefeuilles
  /// encore confidentiels : le filtre est posé dans `scopeRegulatory`, pas dans l'écran, pour
  /// qu'un dossier verrouillé ne puisse pas ressortir par une autre porte (recherche, stocks,
  /// assistant, portail fournisseur…).
  isLocked Boolean @default(false)

  responsibleId String?
  responsible   User?   @relation("RegulatoryResponsible", fields: [responsibleId], references: [id])
  assistantId   String?
  assistant     User?   @relation("RegulatoryAssistant", fields: [assistantId], references: [id])
  // Row-level access: only these users (plus privileged roles) see the line.
  assignedUsers User[]  @relation("RegulatoryAssignedUsers")

  steps          RegulatoryStep[]
  variations     RegulatoryVariation[] // variations de fabrication (Importation → packaging local)
  stockMovements StockMovement[] // mouvements de stock PCH rattachés à ce produit
  stockSnapshots StockSnapshot[] // états de stock datés (PCH / hôpital / annexes)
  regRequests    RegulatoryRequest[] // demandes de l'information médicale (PRIM) sur ce dossier

  // ─── Vue fournisseur (portail externe) — pilotée par l'équipe Regulatory ───
  // Le fournisseur ne voit QUE ces champs externes, jamais le statut/les notes
  // internes, et uniquement si portalVisible = true.
  supplierId             String?
  supplier               Supplier?                 @relation(fields: [supplierId], references: [id])
  portalVisible          Boolean                   @default(false)
  externalStatus         ExternalRegulatoryStatus?
  externalComment        String?
  externalNextStep       String?
  externalActionExpected String?
  externalDeadline       DateTime?
  externalNotify         Boolean                   @default(false)
  externalUpdatedAt      DateTime?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([responsibleId])
  @@index([assistantId])
  @@index([dci])
  @@index([supplierId])
  @@index([isLocked])
}

// Variation de fabrication : après la DE d'un produit, on peut demander une variation
// vers un packaging local (secondaire / primaire / full process). Chaîne possible dans le temps.
model RegulatoryVariation {
  id           String              @id @default(cuid())
  productId    String
  product      RegulatoryProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  toStatus     ManufacturingStatus // cible de la variation (SECONDARY / PRIMARY / FULL_PROCESS)
  status       VariationStatus     @default(EN_ATTENTE)
  depotDate    DateTime? // date de dépôt de la variation
  decisionDate DateTime? // date de la décision (obtenue / annulée)
  manufacturer String? // fabricant associé à la variation
  note         String?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([productId])
}

model RegulatoryStep {
  id          String             @id @default(cuid())
  productId   String
  product     RegulatoryProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        RegulatoryStepType
  order       Int
  status      StepStatus         @default(NOT_STARTED)
  plannedDate DateTime?
  actualDate  DateTime?
  responsible String?
  comment     String?
  missingDocs String? // pièces manquantes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, type])
  @@index([productId])
  @@index([status])
}

// ───────────────────────────── Sponsoring ─────────────────────────────

model SponsoringRequest {
  custom              Json? // admin-defined dynamic fields
  id                  String           @id @default(cuid())
  companyId           String? // entité de rattachement (Adventum / Pharmagène / …)
  company             Company?         @relation(fields: [companyId], references: [id])
  reference           String           @unique
  requestDate         DateTime         @default(now())
  requesterId         String?
  requester           User?            @relation(fields: [requesterId], references: [id])
  institution         String // institution / service / association
  doctor              String? // médecin concerné
  specialty           String?
  city                String?
  type                String // type de sponsoring
  description         String?
  amountRequested     Decimal?         @db.Decimal(12, 2)
  amountProposed      Decimal?         @db.Decimal(12, 2)
  amountGranted       Decimal?         @db.Decimal(12, 2)
  status              SponsoringStatus @default(RECEIVED)
  strategicImportance Priority         @default(MEDIUM)
  product             String? // produit concerné
  expectedRoi         String?
  finalDecision       String? // commentaire final de la Direction (visible par le délégué)
  validatedBy         String?
  validationDate      DateTime?
  comments            String? // appréciation / recommandation du délégué

  // Circuit de validation (calqué sur les congrès) — préliminaire (Direction) →
  // analyse chef de produit (avis + budget proposé, CONFIDENTIELS vis-à-vis du délégué)
  // → décision définitive (Direction : budget final + commentaire) → appel possible.
  preliminaryById      String?
  preliminaryAt        DateTime?
  preliminaryNote      String? // note interne de pré-validation (non visible par le délégué)
  productManagerId     String?
  productManagerBudget Decimal?  @db.Decimal(12, 2) // budget proposé par le chef de produit — CONFIDENTIEL
  productManagerNotes  String? // avis du chef de produit — CONFIDENTIEL (jamais montré au délégué)
  finalById            String?
  finalAt              DateTime?
  expenseOrderId       String? // ordre de dépense émis à la validation définitive
  appealById           String?
  appealAt             DateTime?
  appealReason         String? // motif de l'appel du délégué
  appealCount          Int       @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items AdProItem[]

  @@index([status])
  @@index([strategicImportance])
  @@index([requesterId])
  @@index([productManagerId])
  @@index([companyId])
}

/// Nature d'un poste Ad & Pro. `PROMO_MATERIAL` est à part : ce poste ne se traite pas ici,
/// il POINTE vers un `PromoMaterial` qui suit son propre circuit (visa publicitaire,
/// conformité information médicale, agence, BAT).
enum AdProItemKind {
  STAND
  SYMPOSIUM
  PROMO_MATERIAL
  SERVICE
  TRAVEL
  CONSULTING
  CATERING
  VENUE
  OTHER
}

/// CYCLE DE VALIDATION D'UN POSTE — chaque poste (consulting, traiteur, location de salle…) se
/// valide INDÉPENDAMMENT auprès de la Direction, qui accepte, refuse, ou demande à revoir le
/// budget — autant de fois qu'il le faut. `REVISION` renvoie la main au demandeur sans clore.
enum AdProItemStatus {
  DRAFT // en préparation : on décrit, on demande un devis, on joint les pièces
  PENDING // soumis à la Direction
  REVISION // budget à revoir — le demandeur corrige et resoumet
  APPROVED
  REJECTED
}

/// Un poste pèse-t-il SUR l'enveloppe déjà accordée, ou demande-t-il une RALLONGE ? La question
/// est posée à l'ajout : sans elle, un poste supplémentaire passerait pour un dépassement.
enum AdProItemBudgetKind {
  INCLUDED // déjà couvert par le budget accordé de l'opération
  ADDITIONAL // budget SUPPLÉMENTAIRE demandé en plus de l'enveloppe
}

/// ÉMISSION DU BON DE COMMANDE d'un poste accordé : demandée, visée par la Direction, puis
/// émise par les Finances (l'ordre de dépense naît à ce moment-là).
enum AdProItemOrderStage {
  NONE
  REQUESTED // demande d'émission déposée
  DIRECTION_OK // visa Direction obtenu — en attente des Finances
  ISSUED // Finances : ordre de dépense émis
  REFUSED
}

/// UN POSTE D'UNE OPÉRATION AD & PRO — de quoi est fait le montant.
///
/// Un sponsoring ou un congrès n'est presque jamais un simple chèque : il y a l'appui à
/// l'association ou les frais d'inscription, mais aussi le stand, le symposium, les brochures
/// produites pour l'occasion. Les modules ne portaient qu'un montant global : on ne savait ni de
/// quoi il était fait, ni à qui allait l'argent, et le matériel promotionnel produit pour
/// l'événement vivait sans aucun lien.
///
/// ⚠️ Un poste n'est PAS une demande : il ne déclenche aucun circuit de validation propre.
/// L'opération garde son circuit unique (National Sales → chef de produit → Direction) et les
/// postes en sont la ventilation. Multiplier les circuits triplerait la bureaucratie que le
/// moteur cherche justement à réduire.
///
/// **Deux clés étrangères plutôt qu'un couple (type, id)** : une colonne polymorphe ne peut
/// pas porter de contrainte, donc supprimer un congrès laisserait ses postes orphelins. Ici la
/// suppression en cascade est garantie par la base. Ajouter les congrès internationaux ou les
/// événements se fera par une colonne de plus, pas par une refonte.
/// Exactement UN parent est renseigné (contrainte `AdProItem_one_parent`).
model AdProItem {
  id                      String                 @id @default(cuid())
  sponsoringId            String?
  sponsoring              SponsoringRequest?     @relation(fields: [sponsoringId], references: [id], onDelete: Cascade)
  congressNationalId      String?
  congressNational        CongressNational?      @relation(fields: [congressNationalId], references: [id], onDelete: Cascade)
  /// Les DEUX autres opérations Ad & Pro qui portent des postes : prises en charge
  /// internationales et événements. Une colonne de plus par module (jamais une colonne
  /// polymorphe) : la cascade reste garantie par la base.
  congressInternationalId String?
  congressInternational   CongressInternational? @relation(fields: [congressInternationalId], references: [id], onDelete: Cascade)
  eventId                 String?
  event                   Event?                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Cinquième porteur de postes : une FORMATION organisée par les RH (location de salle,
  /// traiteur, intervenant…), validés un par un par la direction — exactement comme les
  /// postes d'un sponsoring.
  trainingId              String?
  training                Training?              @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  kind     AdProItemKind @default(OTHER)
  label    String
  notes    String?
  /// À QUI on paie ce poste : l'organisateur pour un stand, l'agence pour du matériel,
  /// l'association pour l'appui. C'est ce qui justifie un ordre de dépense par poste.
  supplier String?

  amountEstimated Decimal? @db.Decimal(14, 2) // estimation du demandeur
  amountGranted   Decimal? @db.Decimal(14, 2) // part de l'enveloppe affectée à ce poste

  /// Rattachement au circuit du matériel promotionnel (jamais recopié ici).
  promoMaterialId String?
  /// Ordre de dépense propre à ce poste — les bénéficiaires diffèrent, les pièces aussi.
  expenseOrderId  String?

  /// Ajouté APRÈS la décision définitive. Ne bloque rien — mais la ventilation dépasse alors
  /// l'enveloppe accordée, et l'écran doit le dire au lieu de le masquer.
  addedAfterDecision Boolean @default(false)

  /// ─── Validation propre au poste (Direction) ───
  status       AdProItemStatus     @default(DRAFT)
  budgetKind   AdProItemBudgetKind @default(INCLUDED)
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?

  /// Budget choisi APRÈS accord (catégorie d'enveloppe) — « comme d'habitude ».
  budgetCategoryId String?
  budgetCategory   BudgetCategoryLine? @relation(fields: [budgetCategoryId], references: [id], onDelete: SetNull)

  /// Demande administrative ouverte pour OBTENIR LE DEVIS (Bureau du secrétariat). Les devis
  /// déposés y sont joints, puis rattachés au poste pour la demande de validation.
  adminRequestId String?
  adminRequest   AdministrativeRequest? @relation("AdProItemQuoteRequest", fields: [adminRequestId], references: [id], onDelete: SetNull)

  /// ─── Émission du bon de commande (Direction puis Finances) ───
  orderStage         AdProItemOrderStage @default(NONE)
  orderRequestedAt   DateTime?
  orderRequestedById String?
  orderDirectionAt   DateTime?
  orderDirectionById String?
  orderNote          String?

  decisions AdProItemDecision[]

  position    Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sponsoringId])
  @@index([congressNationalId])
  @@index([congressInternationalId])
  @@index([eventId])
  @@index([promoMaterialId])
  @@index([status])
}

/// HISTORIQUE DES DÉCISIONS D'UN POSTE — « autant de fois qu'il le faut » : une demande de
/// révision n'écrase pas la précédente, elle s'ajoute. Sans cette trace, un poste accordé au
/// 3ᵉ tour ne dirait plus rien des deux refus qui l'ont précédé.
model AdProItemDecision {
  id       String          @id @default(cuid())
  itemId   String
  item     AdProItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  decision AdProItemStatus // PENDING (soumission) | APPROVED | REJECTED | REVISION
  note     String?
  amount   Decimal?        @db.Decimal(14, 2) // montant en jeu au moment de la décision
  byId     String?
  by       User?           @relation("AdProItemDecider", fields: [byId], references: [id], onDelete: SetNull)
  at       DateTime        @default(now())

  @@index([itemId, at])
}

// ───────────────────────────── Budgets ─────────────────────────────

model BudgetLine {
  custom          Json? // admin-defined dynamic fields
  id              String         @id @default(cuid())
  year            Int
  month           Int? // 1-12, null = annual line
  department      BudgetCategory
  label           String // ligne budgétaire
  initialBudget   Decimal        @default(0) @db.Decimal(14, 2)
  consumedBudget  Decimal        @default(0) @db.Decimal(14, 2)
  futureCommitted Decimal        @default(0) @db.Decimal(14, 2)
  status          BudgetStatus   @default(ON_TRACK)
  comments        String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@index([department])
  @@index([status])
}

// Enveloppe budgétaire : un budget TOTAL défini par la Direction pour une période,
// réparti en catégories (BudgetCategoryLine). La consommation est calculée à partir
// des dépenses réelles (FinanceTransaction OUT) attribuées à chaque catégorie.
model BudgetEnvelope {
  id             String               @id @default(cuid())
  companyId      String? // entité de rattachement (Adventum / Pharmagène / …)
  company        Company?             @relation(fields: [companyId], references: [id])
  name           String
  module         String? // (déprécié) module principal — conservé pour compatibilité
  // Une enveloppe peut couvrir UN ou PLUSIEURS modules.
  modules        String[]             @default([]) // SPONSORING, CONGRESS_*, EVENTS, PROMO_MATERIAL, MEDICAL…
  // Rôles (hors gestionnaires) autorisés à CONSULTER cette enveloppe — ex. la
  // Direction des opérations ne voit que les enveloppes que le Super Admin a
  // ouvertes. Vide = visible des seuls gestionnaires (Super Admin / délégués).
  accessRoles    String[]             @default([])
  // Utilisateurs nommément autorisés par le Super Admin à consulter cette enveloppe
  // (en plus des rôles ci-dessus). Permet d'ouvrir l'accès à des personnes précises.
  accessUserIds  String[]             @default([])
  // GESTION (niveau supérieur à la simple visualisation) : rôles / personnes autorisés
  // par l'admin à GÉRER le CONTENU de cette enveloppe précise (catégories, allocations,
  // lignes de dépense budgétaire) — sans être gestionnaire global. La modification de
  // l'enveloppe elle-même (montant, période, listes d'accès) reste réservée à l'admin.
  managerRoles   String[]             @default([])
  managerUserIds String[]             @default([])
  periodStart    DateTime
  periodEnd      DateTime
  totalAmount    Decimal              @default(0) @db.Decimal(14, 2)
  notes          String?
  isActive       Boolean              @default(true)
  categories     BudgetCategoryLine[]
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([isActive])
  @@index([periodStart])
  @@index([companyId])
}

// Catégorie créée par la Direction au sein d'une enveloppe, avec son allocation.
model BudgetCategoryLine {
  id               String                    @id @default(cuid())
  envelopeId       String
  envelope         BudgetEnvelope            @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  name             String
  module           String? // module associé (SPONSORING, CONGRESS_*, REGULATORY…) — attribution auto des dépenses
  // Sous-catégorie : une catégorie peut être rattachée à une catégorie parente
  // (ex. « Table ronde » sous « Événement »). Créées à la main par la Direction.
  parentId         String?
  parent           BudgetCategoryLine?       @relation("BudgetSubCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children         BudgetCategoryLine[]      @relation("BudgetSubCategory")
  allocated        Decimal                   @default(0) @db.Decimal(14, 2)
  color            String?
  notes            String?
  transactions     FinanceTransaction[]
  expenseLines     BudgetExpenseLine[]
  adProItems       AdProItem[]
  /// Dépenses des moyens généraux imputées ici — le ticket entier, puis article par article.
  deptExpenses     DepartmentBudgetExpense[] @relation("DeptExpenseBudget")
  deptExpenseLines DepartmentExpenseLine[]   @relation("DeptExpenseLineBudget")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([envelopeId])
  @@index([parentId])
}

// Ligne de dépense purement BUDGÉTAIRE, saisie depuis le module Budget (« + » : référence
// + montant). Elle CONSOMME une (sous-)catégorie mais ne touche NI la trésorerie NI les
// Finances : c'est un simple suivi de consommation. Le financier reste libre d'enregistrer
// (ou non) le mouvement réel côté Finances. Distincte des FinanceTransaction attribuées, qui
// sont, elles, de vrais mouvements de trésorerie que la Direction impute à une catégorie.
/// BUDGET D'UN DÉPARTEMENT, pour une année.
///
/// Deux natures de budget, DEUX responsables — c'est tout l'intérêt du modèle :
///   • `OPERATING` — le fonctionnement (hors employés), réglé par l'ADMINISTRATEUR ;
///   • `HR` — la masse salariale et le recrutement, réglés par les RESSOURCES HUMAINES.
///
/// Une ligne par département, année et nature : le RH ne peut pas toucher au fonctionnement,
/// l'administrateur ne peut pas toucher à la masse salariale, et l'un n'écrase jamais l'autre
/// puisqu'ils n'écrivent pas la même ligne.
/// AUTORISATIONS SUR LE BUDGET D'UN DÉPARTEMENT — réglées par le Super Admin.
///
/// Une ligne par département, plus UNE ligne générale (`departmentId = null`) qui s'applique à
/// tous. Les deux se CUMULENT : la règle générale ouvre largement, la règle du département
/// ajoute quelqu'un pour ce département seulement. Rien ne se soustrait — voir
/// `department-budget.ts` pour la règle exacte et pourquoi elle est additive.
///
/// Trois portées distinctes, parce que ce ne sont pas les mêmes personnes :
///   • `access*`    — VOIR le budget du département ;
///   • `operating*` — ÉDITER le fonctionnement (hors employés) ;
///   • `hr*`        — ÉDITER les employés et le recrutement.
model DepartmentBudgetAccess {
  id               String      @id @default(cuid())
  /// `null` = règle GÉNÉRALE, valable pour tous les départements. Unicité garantie par un
  /// index partiel (`WHERE "departmentId" IS NULL`) : en SQL, deux NULL ne s'égalent pas, un
  /// `@unique` ordinaire laisserait donc créer autant de règles générales qu'on veut.
  departmentId     String?     @unique
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  accessRoles      String[]    @default([])
  accessUserIds    String[]    @default([])
  operatingRoles   String[]    @default([])
  operatingUserIds String[]    @default([])
  hrRoles          String[]    @default([])
  hrUserIds        String[]    @default([])
  /// Budget MÉTIER : listes propres, parce qu'ouvrir les moyens généraux à quelqu'un ne doit
  /// pas lui ouvrir, par ricochet, le budget d'activité du département.
  activityRoles    String[]    @default([])
  activityUserIds  String[]    @default([])
  /// Qui a réglé ces accès en dernier — une autorisation sans auteur ne se discute pas.
  setById          String?
  setBy            User?       @relation("DepartmentBudgetAccessSetter", fields: [setById], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model DepartmentBudget {
  id           String               @id @default(cuid())
  departmentId String
  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year         Int
  kind         DepartmentBudgetKind
  amount       Decimal              @default(0) @db.Decimal(14, 2)
  notes        String?
  /// Qui a réglé ce montant en dernier — la responsabilité doit être lisible.
  setById      String?
  setBy        User?                @relation("DepartmentBudgetSetter", fields: [setById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([departmentId, year, kind])
  @@index([year, kind])
}

/// DEMANDE DE DOTATION OU DE RALLONGE sur un budget départemental.
///
/// Celui qui gère le budget ne se l'accorde pas à lui-même : il le DEMANDE, l'administration
/// tranche. C'est ce qui rend vérifiable la phrase « budget fixé par les RH, validé par
/// l'administration » — sans ce circuit, elle ne serait qu'un usage.
model DepartmentBudgetRequest {
  id            String                  @id @default(cuid())
  departmentId  String
  department    Department              @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year          Int
  kind          DepartmentBudgetKind
  /// Montant demandé EN PLUS du budget courant. Une dotation initiale est une rallonge
  /// partant de zéro — même geste, même circuit.
  amount        Decimal                 @default(0) @db.Decimal(14, 2)
  reason        String?
  status        DeptBudgetRequestStatus @default(PENDING)
  requestedById String?
  requestedBy   User?                   @relation("DeptBudgetRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now())
  decidedById   String?
  decidedBy     User?                   @relation("DeptBudgetDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?

  @@index([departmentId, year])
  @@index([status])
}

/// FORMATION — deux origines, un seul objet.
///
/// Soit un salarié DEMANDE une formation (il chiffre, joint le devis, et la demande monte
/// N+1 → RH → DG comme un congé) ; soit les RH en ORGANISENT une et y invitent des personnes.
/// Les deux produisent la même chose — une formation à financer et à suivre — et les séparer
/// en deux modèles aurait dédoublé le budget, les pièces et l'historique.
enum TrainingOrigin {
  EMPLOYEE /// demandée par le salarié
  HR /// organisée par les ressources humaines
}

enum TrainingStatus {
  DRAFT /// en préparation (RH), pas encore soumise
  PENDING /// dans le circuit de validation
  APPROVED /// accordée
  REJECTED /// refusée
  CANCELLED /// retirée
  DONE /// formation réalisée
}

/// Participation à une formation organisée par les RH.
enum TrainingAttendance {
  MANDATORY /// convoqué — la présence n'est pas une option
  VOLUNTARY /// invité — il accepte ou décline
}

enum TrainingParticipantState {
  INVITED
  ACCEPTED
  DECLINED
}

model Training {
  id            String         @id @default(cuid())
  companyId     String?
  company       Company?       @relation(fields: [companyId], references: [id])
  reference     String         @unique /// FORM-AAAA-NNN
  title         String
  origin        TrainingOrigin @default(EMPLOYEE)
  status        TrainingStatus @default(PENDING)
  /// Organisme / formateur.
  provider      String?
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  location      String?
  /// Coût annoncé par le demandeur (le devis fait foi, la pièce jointe le porte).
  amount        Decimal        @default(0) @db.Decimal(14, 2)
  /// Montant réellement accordé par la direction — souvent différent du demandé.
  amountGranted Decimal?       @db.Decimal(14, 2)

  requesterId  String?
  requester    User?       @relation("TrainingRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// ─── Circuit à trois marches : N+1 → RH → DG (cf. approval-chain.ts) ───
  /// Une formation ORGANISÉE par les RH n'a pas de N+1 à consulter : elle entre à l'étape DG.
  stage              LeaveStage @default(MANAGER)
  managerId          String?
  managerDecidedById String?
  managerDecidedAt   DateTime?
  managerNote        String?
  hrDecidedById      String?
  hrDecidedAt        DateTime?
  hrNote             String?
  dgDecidedById      String?
  dgDecidedAt        DateTime?
  dgNote             String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants TrainingParticipant[]
  items        AdProItem[]

  @@index([status])
  @@index([requesterId])
  @@index([departmentId])
  @@index([companyId])
}

/// Une personne conviée à une formation organisée par les RH. Obligatoire ou volontaire —
/// et dans le second cas, elle répond : accepter une invitation qu'on ne pouvait pas refuser
/// n'aurait aucun sens, et le savoir change la logistique (nombre de couverts, salle).
model TrainingParticipant {
  id          String                   @id @default(cuid())
  trainingId  String
  training    Training                 @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  userId      String
  user        User                     @relation("TrainingParticipant", fields: [userId], references: [id], onDelete: Cascade)
  attendance  TrainingAttendance       @default(VOLUNTARY)
  state       TrainingParticipantState @default(INVITED)
  respondedAt DateTime?
  note        String?
  createdAt   DateTime                 @default(now())

  @@unique([trainingId, userId])
  @@index([userId, state])
}

/// CAISSE D'AVANCE — la trésorerie temporaire confiée à une personne.
///
/// Chaque mois, l'entreprise remet une somme à celle qui achète au quotidien (l'assistante de
/// direction). Elle marque « reçu » — sans cette confirmation, on ne sait pas si l'argent a
/// réellement changé de mains — puis chaque dépense en est DÉDUITE, justificatif à l'appui,
/// jusqu'à épuisement. Quand il ne reste plus rien, elle demande une rallonge.
///
/// Ce n'est pas un budget : c'est de l'argent physiquement détenu. Le budget dit ce qu'on a le
/// droit de dépenser, la caisse dit ce qu'on a en main — confondre les deux, c'est ne plus
/// savoir combien il reste dans le tiroir.
enum PettyCashStatus {
  ALLOTTED /// remise décidée, pas encore confirmée par le détenteur
  RECEIVED /// argent reçu — la caisse est ouverte, les dépenses s'y imputent
  CLOSED /// caisse soldée (épuisée ou clôturée)
}

/// LE RÉGLAGE MENSUEL de la caisse d'avance : combien, à qui, et quel jour du mois.
///
/// Sans ce réglage, la caisse dépendait d'un geste dont personne ne se souvenait à date fixe —
/// et l'on ne pouvait prévenir de rien, faute de savoir quand le rechargement était attendu.
/// C'est aussi ce qui rend possible le rappel aux ressources humaines **48 h avant**.
model PettyCashPlan {
  id                 String     @id @default(cuid())
  departmentId       String     @unique
  department         Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Somme remise chaque mois (réglée par les ressources humaines).
  monthlyAmount      Decimal    @default(0) @db.Decimal(14, 2)
  /// Jour du mois où la caisse est rechargée (1–28 : au-delà, février ferait exception).
  rechargeDay        Int        @default(1)
  /// La personne à qui la somme est remise (l'assistante de direction, en pratique).
  holderId           String?
  holder             User?      @relation("PettyCashPlanHolder", fields: [holderId], references: [id], onDelete: SetNull)
  isActive           Boolean    @default(true)
  /// Dernière période (« AAAA-MM ») pour laquelle le rappel des 48 h est parti — sans cette
  /// trace, le battement du planificateur enverrait la même alerte à chaque passage.
  lastReminderPeriod String?
  setById            String?
  setBy              User?      @relation("PettyCashPlanSetter", fields: [setById], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

/// DEMANDE DE RALLONGE sur une caisse épuisée — tranchée par les ressources humaines.
///
/// La rallonge n'était qu'une notification : rien à accorder, rien à refuser, aucune trace de
/// ce qui avait été décidé. Les RH accordent désormais **le montant qu'elles écrivent** — qui
/// est rarement celui demandé — refusent, et la décision reste lisible.
enum PettyCashTopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

model PettyCashTopUpRequest {
  id              String               @id @default(cuid())
  allotmentId     String
  allotment       PettyCashAllotment   @relation(fields: [allotmentId], references: [id], onDelete: Cascade)
  amountRequested Decimal              @default(0) @db.Decimal(14, 2)
  reason          String?
  status          PettyCashTopUpStatus @default(PENDING)
  /// Montant réellement accordé — écrit par les RH, souvent différent du demandé.
  amountGranted   Decimal?             @db.Decimal(14, 2)
  requestedById   String?
  requestedBy     User?                @relation("PettyCashTopUpRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById     String?
  decidedBy       User?                @relation("PettyCashTopUpDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime             @default(now())

  @@index([allotmentId])
  @@index([status])
}

model PettyCashAllotment {
  id           String          @id @default(cuid())
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Mois concerné, « AAAA-MM ». Une caisse par mois et par détenteur : mélanger deux mois,
  /// c'est perdre la capacité de dire « il restait combien fin juillet ».
  period       String
  amount       Decimal         @default(0) @db.Decimal(14, 2)
  status       PettyCashStatus @default(ALLOTTED)
  /// Qui DÉTIENT la caisse (et confirme la réception).
  holderId     String?
  holder       User?           @relation("PettyCashHolder", fields: [holderId], references: [id], onDelete: SetNull)
  receivedAt   DateTime?
  note         String?
  createdById  String?
  createdBy    User?           @relation("PettyCashCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  expenses DepartmentBudgetExpense[]
  topUps   PettyCashTopUpRequest[]

  @@index([departmentId, period])
  @@index([holderId, status])
}

/// DÉPENSE IMPUTÉE à un budget départemental — avec sa pièce justificative (Document lié par
/// `entityType = DEPARTMENT_EXPENSE`).
///
/// Sans elle, les moyens généraux affichaient un montant alloué et AUCUNE consommation : un
/// budget qu'on ne peut pas confronter à ses dépenses n'est pas un budget, c'est un vœu.
/// L'assistante de direction y classe ce qu'elle achève (fournitures, prestations) ; le
/// directeur y voit ce que son département consomme réellement.
model DepartmentBudgetExpense {
  id               String                 @id @default(cuid())
  departmentId     String
  department       Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year             Int
  kind             DepartmentBudgetKind   @default(OPERATING)
  label            String
  amount           Decimal                @default(0) @db.Decimal(14, 2)
  date             DateTime               @default(now())
  notes            String?
  /// Caisse d'avance sur laquelle cette dépense a été PAYÉE (argent physiquement sorti du
  /// tiroir). Nulle quand la dépense est réglée par virement ou par les Finances.
  pettyCashId      String?
  pettyCash        PettyCashAllotment?    @relation(fields: [pettyCashId], references: [id], onDelete: SetNull)
  /// Demande administrative dont cette dépense est issue (traçabilité de bout en bout).
  adminRequestId   String?
  adminRequest     AdministrativeRequest? @relation(fields: [adminRequestId], references: [id], onDelete: SetNull)
  /// CLASSEMENT BUDGÉTAIRE DU TICKET ENTIER — choisi par celui qui achète, sans qu'il ait
  /// accès au module Budget. Sert de destination au RESTE non classé article par article.
  budgetCategoryId String?
  budgetCategory   BudgetCategoryLine?    @relation("DeptExpenseBudget", fields: [budgetCategoryId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?                  @relation("DeptExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())

  /// Le DÉTAIL du ticket : un même justificatif porte presque toujours plusieurs articles.
  lines DepartmentExpenseLine[]

  @@index([departmentId, year, kind])
  @@index([adminRequestId])
  @@index([pettyCashId])
  @@index([budgetCategoryId])
  @@index([date])
}

/// UN ARTICLE D'UN TICKET DE CAISSE / D'UNE FACTURE.
///
/// Une dépense n'était qu'un libellé et un montant : « courses 12 400 DZD ». On savait ce qui
/// était sorti de la caisse, jamais ce qui avait été acheté — donc ni ce qu'on consomme le
/// plus, ni à quel prix, ni si le total du ticket correspond à ce qu'on y a mis. Une pièce
/// justificative porte presque toujours PLUSIEURS articles : le modèle le dit maintenant.
///
/// Le `label` est FIGÉ à l'achat, en plus du lien vers le catalogue : un article renommé ou
/// retiré du catalogue ne doit pas réécrire l'histoire d'un ticket déjà classé — et un achat
/// hors catalogue (article acheté une fois) reste possible, `articleId` valant alors NULL.
model DepartmentExpenseLine {
  id               String                  @id @default(cuid())
  expenseId        String
  expense          DepartmentBudgetExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  articleId        String?
  article          OfficeSupplyArticle?    @relation(fields: [articleId], references: [id], onDelete: SetNull)
  /// Désignation au moment de l'achat (recopiée du catalogue, ou saisie libre).
  label            String
  quantity         Decimal                 @default(1) @db.Decimal(12, 3)
  /// Montant de la ligne (quantité × prix unitaire, ou saisi tel quel depuis le ticket).
  amount           Decimal                 @default(0) @db.Decimal(14, 2)
  /// CLASSEMENT BUDGÉTAIRE DE CET ARTICLE — un même ticket mélange papeterie, transport et
  /// entretien : chaque article rejoint sa propre case, indépendamment des autres.
  budgetCategoryId String?
  budgetCategory   BudgetCategoryLine?     @relation("DeptExpenseLineBudget", fields: [budgetCategoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())

  @@index([expenseId])
  @@index([articleId])
  @@index([budgetCategoryId])
}

enum DepartmentBudgetKind {
  OPERATING /// MOYENS GÉNÉRAUX — fournitures, prestations, déplacements (directeur du département)
  HR /// MASSE SALARIALE — employés, charges et recrutement (ressources humaines, exclusivement)
  ACTIVITY /// BUDGET MÉTIER — l'activité propre du département (Ad & Pro au marketing, paiement des BV au Regulatory…)
  TRAINING /// BUDGET FORMATION — montée en compétence de l'équipe (RH, validé par l'administration)
}

/// Une dotation (montant initial) ou une RALLONGE demandée par celui qui gère un budget
/// départemental, et accordée — ou non — par l'administration. Les deux gestes sont le même :
/// une rallonge partant de zéro EST une dotation. Un seul circuit, une seule trace.
enum DeptBudgetRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model BudgetExpenseLine {
  id          String             @id @default(cuid())
  categoryId  String
  category    BudgetCategoryLine @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  reference   String // référence saisie (sert de libellé de la dépense)
  amount      Decimal            @default(0) @db.Decimal(14, 2)
  date        DateTime           @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime           @default(now())

  @@index([categoryId])
  @@index([date])
}

// ───────────────────────────── Congresses ─────────────────────────────

model CongressInternational {
  custom           Json? // admin-defined dynamic fields
  id               String            @id @default(cuid())
  companyId        String? // entité de rattachement (Adventum / Pharmagène / …)
  company          Company?          @relation(fields: [companyId], references: [id])
  name             String
  eventType        NationalEventType @default(CONGRESS) // type d'événement (congrès, séminaire, formation…)
  country          String?
  city             String?
  startDate        DateTime?
  endDate          DateTime?
  specialty        String?
  participants     String? // participants Adventum
  invitedDoctors   String?
  products         String?
  plannedBudget    Decimal?          @db.Decimal(14, 2)
  actualBudget     Decimal?          @db.Decimal(14, 2)
  status           CongressStatus    @default(CONSIDERED)
  hotel            String?
  flight           String?
  visa             String?
  registration     String?
  linkedSponsoring String?
  postEventReport  String?
  generatedLeads   String? // opportunités générées

  // ─── Demande de prise en charge (workflow) ───
  requesterId          String? // délégué / superviseur qui fait la demande
  requestStatus        CongressRequestStatus @default(AWAITING_PRELIMINARY)
  estimatedBudget      Decimal?              @db.Decimal(14, 2) // budget estimé par le demandeur
  invitedDoctorIds     String[]              @default([]) // médecins invités (depuis Promotion médicale)
  participantIds       String[]              @default([]) // participants Adventum (users)
  productManagerId     String? // chef de produit assigné à l'analyse
  productManagerBudget Decimal?              @db.Decimal(14, 2) // budget proposé par le chef de produit
  productManagerNotes  String?
  preliminaryById      String?
  preliminaryAt        DateTime?
  preliminaryNote      String?
  finalById            String?
  finalAt              DateTime?
  finalNote            String?
  finalAmount          Decimal?              @db.Decimal(14, 2) // montant accordé par la Direction à la validation définitive
  rejectionReason      String?
  expenseOrderId       String? // ordre de dépense émis après validation définitive
  beneficiaries        Json? // personnes prises en charge : [{ id, name, role }] (pièces d'identité = Documents catégorie ID_DOCUMENT, stepKey = id)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  careBeneficiaries CareBeneficiary[]
  careQuotes        CareQuote[]

  /// Postes (consulting, traiteur, salle…) validés un par un — voir AdProItem.
  items AdProItem[]

  @@index([status])
  @@index([startDate])
  @@index([requestStatus])
  @@index([requesterId])
  @@index([companyId])
}

model CongressNational {
  custom           Json? // admin-defined dynamic fields
  id               String         @id @default(cuid())
  companyId        String? // entité de rattachement (Adventum / Pharmagène / …)
  company          Company?       @relation(fields: [companyId], references: [id])
  name             String
  country          String? // optionnel — un événement « national » peut se tenir hors d'Algérie
  city             String?
  hostInstitution  String? // hôpital / association
  date             DateTime?
  specialty        String?
  presentDoctors   String?
  promotedProducts String?
  budget           Decimal?       @db.Decimal(14, 2)
  hasBooth         Boolean        @default(false)
  hasSymposium     Boolean        @default(false)
  linkedSponsoring String?
  presentDelegates String?
  status           CongressStatus @default(CONSIDERED)
  finalReport      String?

  // ─── Demande de prise en charge (workflow) ───
  eventType            NationalEventType     @default(CONGRESS)
  requesterId          String?
  requestStatus        CongressRequestStatus @default(AWAITING_PRELIMINARY)
  estimatedBudget      Decimal?              @db.Decimal(14, 2)
  invitedDoctorIds     String[]              @default([])
  participantIds       String[]              @default([])
  productManagerId     String?
  productManagerBudget Decimal?              @db.Decimal(14, 2)
  productManagerNotes  String?
  preliminaryById      String?
  preliminaryAt        DateTime?
  preliminaryNote      String?
  finalById            String?
  finalAt              DateTime?
  finalNote            String?
  finalAmount          Decimal?              @db.Decimal(14, 2) // montant accordé par la Direction à la validation définitive
  rejectionReason      String?
  expenseOrderId       String?
  beneficiaries        Json? // personnes prises en charge : [{ id, name, role }] (pièces d'identité = Documents catégorie ID_DOCUMENT, stepKey = id)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items             AdProItem[]
  careBeneficiaries CareBeneficiary[]
  careQuotes        CareQuote[]

  @@index([status])
  @@index([date])
  @@index([requestStatus])
  @@index([requesterId])
  @@index([companyId])
}

// ─────────────────────── Prise en charge : personnes, cases, devis ───────────────────────

/// Avis porté sur UNE personne. « Pas d'avis » est une réponse à part entière : forcer un
/// avis tranché sur quelqu'un qu'on ne connaît pas produit un faux signal.
enum CareOpinion {
  FAVORABLE
  UNFAVORABLE
  NONE
}

/// Où en est UNE personne. La décision est prise **par personne** : sur une même demande,
/// l'une est accordée et l'autre écartée sans qu'on ait à refuser l'ensemble.
enum CareBeneficiaryStatus {
  PROPOSED // proposée, en attente de la décision de la Direction
  APPROVED // accordée
  REJECTED // écartée
  WITHDRAWN // retirée par le demandeur avant décision
}

/// Nature d'une case sur la ligne d'une personne. Deux natures réellement différentes, même
/// si elles s'affichent côte à côte : l'une se COLLECTE, l'autre s'ACHÈTE.
enum CareCellKind {
  DOCUMENT // une pièce à fournir (passeport, visa, CV…)
  SERVICE // un élément à acheter (hôtel, transport, billet, restauration…)
}

enum CareServiceKind {
  HOTEL
  TRANSPORT
  TICKET
  CATERING
  REGISTRATION
  VISA_FEE
  /// Support produit pour CETTE personne (brochure, kit, présentoir). Ne se traite pas ici :
  /// la case POINTE vers un `PromoMaterial` qui suit son propre circuit.
  PROMO_MATERIAL
  OTHER
}

enum CareCellStatus {
  REQUESTED // demandée, rien reçu
  PROVIDED // document déposé, ou devis reçu
  SETTLED // pièce acceptée / devis accepté
  WAIVED // finalement inutile pour cette personne
}

/// UNE PERSONNE À PRENDRE EN CHARGE.
///
/// Remplace le tableau JSON `beneficiaries` : une personne porte désormais un avis, une
/// décision, et sa propre liste de cases. C'est la ligne du tableau.
///
/// Son identité vient soit de l'annuaire médecins, soit d'un profil libre saisi sur place —
/// on ne va pas créer une fiche médecin permanente pour un intervenant vu une seule fois.
///
/// Deux clés étrangères nullables (même raison que `AdProItem`) : une colonne polymorphe ne
/// pourrait pas porter de contrainte, et supprimer une demande laisserait ses personnes
/// orphelines. Contrainte `CareBeneficiary_one_parent` : exactement un parent.
model CareBeneficiary {
  id                      String                 @id @default(cuid())
  congressNationalId      String?
  congressNational        CongressNational?      @relation(fields: [congressNationalId], references: [id], onDelete: Cascade)
  congressInternationalId String?
  congressInternational   CongressInternational? @relation(fields: [congressInternationalId], references: [id], onDelete: Cascade)

  /// Depuis l'annuaire (Promotion médicale). Exclusif avec le profil libre ci-dessous.
  doctorId    String?
  /// Profil libre : la personne n'est pas (ou pas encore) à l'annuaire.
  firstName   String?
  lastName    String?
  /// Poste / titre — « Professeur », « Chef de service »…
  jobTitle    String?
  institution String?

  /// L'avis du DEMANDEUR sur cette personne, avec sa justification.
  requesterOpinion CareOpinion @default(NONE)
  requesterNote    String?

  /// La décision de la Direction, personne par personne.
  status       CareBeneficiaryStatus @default(PROPOSED)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  position    Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cells CareCell[]

  @@index([congressNationalId])
  @@index([congressInternationalId])
  @@index([doctorId])
}

/// UNE CASE sur la ligne d'une personne — ce qu'il faut fournir ou acheter POUR ELLE.
///
/// Chaque personne a ses propres cases : l'une a besoin d'un visa et pas l'autre, l'une loge
/// à l'hôtel et l'autre chez elle. D'où des cases attachées à la personne, et non des colonnes
/// communes à tout le tableau.
model CareCell {
  id            String          @id @default(cuid())
  beneficiaryId String
  beneficiary   CareBeneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  kind        CareCellKind
  /// Renseigné pour une case SERVICE — sert au regroupement et aux libellés.
  serviceKind CareServiceKind?
  label       String
  notes       String?

  status CareCellStatus @default(REQUESTED)

  /// DOCUMENT : la pièce déposée (Document.id).
  documentId      String?
  /// Rattachement au circuit du matériel promotionnel — jamais recopié ici : le matériel a son
  /// propre parcours (visa publicitaire, conformité, agence, BAT) et cette case en montre
  /// seulement l'avancement.
  promoMaterialId String?
  /// SERVICE : le devis retenu et ce qu'il coûte.
  quoteId         String?
  amountDzd       Decimal? @db.Decimal(14, 2)
  expenseOrderId  String?

  /// Qui a demandé cette case — le chef de produit peut en ajouter après coup.
  requestedById String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quoteLinks CareQuoteCell[]

  @@index([beneficiaryId])
  @@index([quoteId])
  @@index([promoMaterialId])
}

enum CareQuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// UN DEVIS reçu par le secrétariat.
///
/// Un devis couvre **ce qu'il couvre réellement** : une agence de voyage chiffre le groupe
/// entier, pas une ligne par personne. Il est donc rattaché aux CASES qu'il couvre (relation
/// n-n), et accepté ou refusé **d'un bloc** — accepter la moitié d'un devis n'a pas de sens
/// commercial.
model CareQuote {
  id                      String                 @id @default(cuid())
  congressNationalId      String?
  congressNational        CongressNational?      @relation(fields: [congressNationalId], references: [id], onDelete: Cascade)
  congressInternationalId String?
  congressInternational   CongressInternational? @relation(fields: [congressInternationalId], references: [id], onDelete: Cascade)

  supplier   String
  reference  String?
  amountDzd  Decimal         @db.Decimal(14, 2)
  status     CareQuoteStatus @default(PENDING)
  /// Le PDF du devis (Document.id).
  documentId String?
  note       String?

  decidedById    String?
  decidedAt      DateTime?
  /// Ordre de dépense émis à l'acceptation.
  expenseOrderId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cells CareQuoteCell[]

  @@index([congressNationalId])
  @@index([congressInternationalId])
  @@index([status])
}

/// Ce qu'un devis couvre : les cases concernées.
model CareQuoteCell {
  quoteId String
  quote   CareQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  cellId  String
  cell    CareCell  @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@id([quoteId, cellId])
  @@index([cellId])
}

// ─────────────────────── Information médicale (déclaration réglementaire) ───────────────────────

/// Étape obligatoire qui s'intercale APRÈS la validation définitive de la Direction
/// (sponsoring / congrès) et AVANT l'envoi de l'ordre de dépense au comptable.
/// Le pharmacien responsable de l'information médicale déclare l'événement aux
/// autorités, peut exiger des pièces (de la Direction, du comptable, du délégué…),
/// puis valide — ce qui déclenche enfin l'ordre de dépense.
enum MedicalInfoStatus {
  AWAITING_REVIEW // validé par la Direction → en attente du pharmacien
  DOCS_REQUESTED // des pièces ont été demandées, en attente de dépôt
  READY // pièces reçues → prêt à valider
  AWAITING_DIRECTION // validé par le pharmacien → en attente de la validation finale de la Direction (pour le comptable)
  VALIDATED // validé par la Direction → ordre de dépense émis (comptable)
}

enum DocRequestStatus {
  PENDING
  FULFILLED
}

model MedicalInfoDeclaration {
  id                      String                  @id @default(cuid())
  companyId               String? // entité (Adventum / Pharmagène / …)
  company                 Company?                @relation(fields: [companyId], references: [id])
  reference               String                  @unique // DIM-2026-001
  sourceType              EntityType // SPONSORING | CONGRESS_INTERNATIONAL | CONGRESS_NATIONAL
  sourceId                String
  label                   String // institution / nom de l'événement
  beneficiary             String? // bénéficiaire (repris pour l'ordre de dépense)
  amount                  Decimal?                @db.Decimal(14, 2) // budget accordé par la Direction
  requesterId             String? // demandeur d'origine (repris pour l'ordre de dépense)
  status                  MedicalInfoStatus       @default(AWAITING_REVIEW)
  pharmacistId            String? // pharmacien en charge (assigné)
  pharmacist              User?                   @relation("MedicalInfoPharmacist", fields: [pharmacistId], references: [id])
  authorityRef            String? // référence / récépissé de déclaration aux autorités
  authorityNotes          String? // notes de déclaration
  pharmacistValidatedAt   DateTime? // validé par le pharmacien (PRIM) → passe à la Direction
  pharmacistValidatedById String?
  validatedAt             DateTime? // validation FINALE par la Direction → ordre de dépense au comptable
  validatedById           String?
  expenseOrderId          String? // ordre de dépense émis après validation du pharmacien
  budgetCategoryId        String? // (sous-)catégorie budgétaire choisie par la Direction à la validation définitive
  archivedNodeId          String? // dossier « Dossier traité » créé dans le Drive du PRIM
  requests                MedicalInfoDocRequest[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([sourceType, sourceId])
  @@index([status])
  @@index([pharmacistId])
}

model MedicalInfoDocRequest {
  id            String                 @id @default(cuid())
  declarationId String
  declaration   MedicalInfoDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  label         String // ce qui est demandé
  targetUserId  String? // à qui la pièce est demandée (Direction / comptable / délégué…)
  targetUser    User?                  @relation("MedicalInfoDocTarget", fields: [targetUserId], references: [id])
  status        DocRequestStatus       @default(PENDING)
  documentId    String? // Document déposé en réponse (model Document)
  note          String? // précision du déposant
  requestedById String?
  fulfilledAt   DateTime?
  createdAt     DateTime               @default(now())

  @@index([declarationId])
  @@index([targetUserId])
  @@index([status])
}

// ───────────────────────── Directives (Direction → équipes) ─────────────────────────

/// Instruction priorisée émise par la Direction vers une personne (targetUserId) ou
/// un rôle entier (targetRole), avec un espace d'échange (DirectiveMessage).
enum DirectiveStatus {
  OPEN // émise, non encore prise en compte
  ACKNOWLEDGED // accusé de réception par le destinataire
  IN_PROGRESS // en cours de traitement
  DONE // traitée
  ARCHIVED // archivée par la Direction
}

model Directive {
  id               String             @id @default(cuid())
  reference        String             @unique // DIR-AAAA-NNN
  title            String
  body             String
  priority         Priority           @default(MEDIUM)
  status           DirectiveStatus    @default(OPEN)
  dueDate          DateTime?
  // Destinataire : un utilisateur précis OU un rôle (diffusion). Au moins l'un des deux.
  targetUserId     String?
  targetUser       User?              @relation("DirectiveTarget", fields: [targetUserId], references: [id])
  targetRole       UserRole?
  fromId           String? // émetteur (Direction)
  from             User?              @relation("DirectiveAuthor", fields: [fromId], references: [id])
  acknowledgedAt   DateTime?
  acknowledgedById String?
  messages         DirectiveMessage[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([targetUserId])
  @@index([targetRole])
  @@index([priority])
}

model DirectiveMessage {
  id          String    @id @default(cuid())
  directiveId String
  directive   Directive @relation(fields: [directiveId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation("DirectiveMsgAuthor", fields: [authorId], references: [id])
  body        String
  createdAt   DateTime  @default(now())

  @@index([directiveId])
}

// ─────────────────── Demandes de support (→ directeur médical / chef de produit) ───────────────────

/// Demande adressée à une fonction (directeur médical, chef de produit…) : question
/// médicale/scientifique, demande de support de visite, brochure, document/PDF. Le
/// destinataire répond dans un fil et peut joindre les pièces demandées (Document).
enum SupportCategory {
  QUESTION // question médicale / scientifique
  SUPPORT_MATERIAL // support / aide à la visite
  BROCHURE // brochure
  DOCUMENT // document / PDF
  OTHER
}

enum SupportStatus {
  OPEN // déposée, en attente de prise en charge
  IN_PROGRESS // prise en charge
  ANSWERED // répondue (pièces / réponse fournies)
  CLOSED // clôturée
}

model SupportRequest {
  id           String           @id @default(cuid())
  companyId    String? // entité de rattachement (Adventum / Pharmagène / …)
  company      Company?         @relation(fields: [companyId], references: [id])
  reference    String           @unique // SUP-AAAA-NNN
  subject      String
  body         String
  category     SupportCategory  @default(QUESTION)
  priority     Priority         @default(MEDIUM)
  product      String?
  status       SupportStatus    @default(OPEN)
  requesterId  String?
  requester    User?            @relation("SupportRequester", fields: [requesterId], references: [id])
  targetRole   UserRole? // fonction visée (directeur médical / chef de produit…)
  targetUserId String? // ou une personne précise
  targetUser   User?            @relation("SupportTarget", fields: [targetUserId], references: [id])
  assignedToId String? // répondant ayant pris en charge
  assignedTo   User?            @relation("SupportAssignee", fields: [assignedToId], references: [id])
  messages     SupportMessage[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([targetRole])
  @@index([assignedToId])
  @@index([companyId])
}

model SupportMessage {
  id        String         @id @default(cuid())
  requestId String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?          @relation("SupportMsgAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime       @default(now())

  @@index([requestId])
}

// Demande de l'information médicale (PRIM) vers l'équipe Regulatory (question réglementaire,
// document, statut d'enregistrement, variation…), rattachable à un dossier produit, avec fil
// de discussion et statut. Le PRIM crée ; Regulatory prend en charge et répond.
enum RegRequestCategory {
  QUESTION // question réglementaire
  DOCUMENT // demande de document réglementaire
  STATUS_UPDATE // point sur le statut d'enregistrement
  VARIATION // variation / modification
  OTHER
}

enum RegRequestStatus {
  OPEN // ouverte (nouvelle)
  IN_PROGRESS // prise en charge par Regulatory
  ANSWERED // réponse apportée
  CLOSED // clôturée
}

model RegulatoryRequest {
  id           String             @id @default(cuid())
  reference    String             @unique // RRQ-AAAA-NNN
  subject      String
  body         String
  category     RegRequestCategory @default(QUESTION)
  priority     Priority           @default(MEDIUM)
  status       RegRequestStatus   @default(OPEN)
  // Dossier produit concerné (optionnel).
  productId    String?
  product      RegulatoryProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  requesterId  String? // le PRIM demandeur
  requester    User?              @relation("RegRequestRequester", fields: [requesterId], references: [id])
  assignedToId String? // répondant Regulatory ayant pris en charge
  assignedTo   User?              @relation("RegRequestAssignee", fields: [assignedToId], references: [id])

  messages  RegulatoryRequestMessage[]
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([assignedToId])
  @@index([productId])
}

model RegulatoryRequestMessage {
  id        String            @id @default(cuid())
  requestId String
  request   RegulatoryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?             @relation("RegRequestMsgAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime          @default(now())

  @@index([requestId])
}

/// Statut d'un dossier de suivi.
enum DossierStatus {
  OPEN // ouvert / à démarrer
  IN_PROGRESS // en cours
  ON_HOLD // en attente (d'un retour, d'une info…)
  DONE // abouti
  ARCHIVED // archivé
}

/// Dossier de suivi d'un sujet ad hoc : on délègue une recherche / analyse / tâche
/// (ex. « rechercher des prix d'hôtels », « analyse IQVIA ») et on suit TOUT au même
/// endroit : description, responsable + participants, statut, fil de discussion et
/// pièces (PPT/Excel/PDF/e-mails) via Document(entityType=DOSSIER). Créable manuellement
/// ou proposé par l'IA depuis un chat / e-mail.
model Dossier {
  id             String           @id @default(cuid())
  companyId      String? // entité de rattachement (Adventum / Pharmagène / …)
  company        Company?         @relation(fields: [companyId], references: [id])
  reference      String           @unique // DOS-AAAA-NNN
  title          String
  description    String?
  category       String? // Recherche, Hôtels, Billets, Analyse IQVIA, Veille…
  priority       Priority         @default(MEDIUM)
  status         DossierStatus    @default(OPEN)
  createdById    String?
  createdBy      User?            @relation("DossierCreator", fields: [createdById], references: [id])
  assignedToId   String? // responsable principal
  assignedTo     User?            @relation("DossierAssignee", fields: [assignedToId], references: [id])
  participantIds String[]         @default([]) // collaborateurs additionnels (userIds)
  /// OBJET D'ORIGINE quand ce dossier est né d'une implication de tierce personne sur une
  /// demande Ad & Pro (congrès, événement) : c'est ce qui permet de faire remonter la
  /// conversation À L'ENDROIT de la demande, au lieu de la laisser dans un projet à part que le
  /// demandeur oublie d'ouvrir.
  sourceType     EntityType?
  sourceId       String?
  dueDate        DateTime?
  messages       DossierMessage[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([companyId])
  @@index([sourceType, sourceId])
}

model DossierMessage {
  id          String                     @id @default(cuid())
  dossierId   String
  dossier     Dossier                    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?                      @relation("DossierMsgAuthor", fields: [authorId], references: [id])
  body        String // peut être vide si le message ne porte qu'une pièce jointe
  mentionIds  String[]                   @default([]) // utilisateurs tagués (@) — doivent être participants
  attachments DossierMessageAttachment[]
  createdAt   DateTime                   @default(now())

  @@index([dossierId])
}

/// Pièce jointe d'un message du fil « Suivi & discussion » (chat) — stockée chiffrée via le
/// backend Drive (blob), comme la messagerie. Supprimée en cascade avec son message.
model DossierMessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  message   DossierMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  blobId    String
  name      String
  mime      String
  size      Int
  createdAt DateTime       @default(now())

  @@index([messageId])
}

// ───────────────────────────── Sales ─────────────────────────────

model Sale {
  custom             Json? // admin-defined dynamic fields
  id                 String         @id @default(cuid())
  companyId          String? // entité (Adventum / Pharmagène / …)
  company            Company?       @relation(fields: [companyId], references: [id])
  date               DateTime       @default(now())
  saleType           SaleType       @default(PRODUCT) // produit ou service
  product            String // désignation (produit ou service)
  serviceDescription String? // détail si c'est un service
  dci                String?
  dosage             String?
  pharmaceuticalForm String?
  client             String
  institution        String?
  isPch              Boolean        @default(false)
  quantity           Int            @default(0)
  unitPrice          Decimal        @default(0) @db.Decimal(12, 2)
  revenue            Decimal        @default(0) @db.Decimal(14, 2)
  estimatedMargin    Decimal?       @db.Decimal(14, 2)
  purchaseOrder      String?
  invoice            String?
  paymentStatus      PaymentStatus  @default(UNPAID)
  deliveryStatus     DeliveryStatus @default(PENDING)
  comment            String?

  salesUserId String?
  salesUser   User?   @relation(fields: [salesUserId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([product])
  @@index([client])
  @@index([salesUserId])
}

// ───────────────────────────── Logistics PCH ─────────────────────────────

model LogisticsOrder {
  custom             Json? // admin-defined dynamic fields
  id                 String          @id @default(cuid())
  companyId          String? // entité (Adventum / Pharmagène / …)
  company            Company?        @relation(fields: [companyId], references: [id])
  reference          String          @unique
  product            String
  dci                String?
  dosage             String?
  pharmaceuticalForm String?
  supplier           String?
  country            String?
  quantityOrdered    Int             @default(0)
  quantityReceived   Int             @default(0)
  quantityDelivered  Int             @default(0)
  orderDate          DateTime?
  estimatedDeparture DateTime?
  actualDeparture    DateTime?
  estimatedArrival   DateTime?
