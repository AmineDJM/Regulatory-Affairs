// ───────────────────────────── Core / identity ─────────────────────────────

/// Département de l'entreprise. Hiérarchie sur N NIVEAUX (« comme une vraie boîte ») :
/// un département peut avoir un parent → ses enfants sont ses SOUS-DÉPARTEMENTS.
/// Racine = parentId null. Chaque département porte un RESPONSABLE (head) et un
/// éventuel ADJOINT (deputy) — ce sont eux qui incarnent le « N+1 » quand un employé
/// n'a pas de manager explicite (voir src/lib/departments.ts).
model Department {
  id          String       @id @default(cuid())
  /// Nom unique PAR ENTITÉ (chaque société peut avoir son propre « Commercial »).
  name        String
  code        String       @unique
  /// Entité de rattachement (Adventum, Pharmagène…). Null = département transverse au groupe.
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentTree")
  // Responsable et adjoint : employés (cohérent avec l'organigramme, qui relie des Employee).
  // L'adjoint prend le relais quand le responsable est le demandeur ou est absent.
  headId      String?
  head        Employee?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  deputyId    String?
  deputy      Employee?    @relation("DepartmentDeputy", fields: [deputyId], references: [id], onDelete: SetNull)
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members        Employee[]                @relation("DepartmentMembers")
  users          User[]
  adminRequests  AdministrativeRequest[]
  mailEntries    MailEntry[]
  recruitments   RecruitmentRequest[]      @relation("RecruitmentDepartment")
  budgets        DepartmentBudget[]
  budgetAccess   DepartmentBudgetAccess?
  budgetRequests DepartmentBudgetRequest[]
  budgetExpenses DepartmentBudgetExpense[]
  pettyCash      PettyCashAllotment[]
  pettyCashPlan  PettyCashPlan?
  trainings      Training[]

  @@unique([companyId, name])
  @@index([parentId])
  @@index([headId])
  @@index([companyId])
}

/// FIL DE CONVERSATION avec l'assistant — STRICTEMENT PERSONNEL.
/// Chaque fil appartient à un compte et un seul. Toute lecture passe par un helper qui
/// exige le `userId` (src/lib/assistant-memory.ts) : un identifiant deviné ne donne rien.
model AssistantThread {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation("AssistantThreads", fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  /// LE FIL PRINCIPAL du Chief of Staff — un par personne : la conversation continue dans le
  /// temps au lieu de s'éparpiller en « chat 1, chat 2, chat 99 ». Les autres fils restent
  /// possibles (sujets à part) ; celui-ci est celui qui s'ouvre par défaut.
  isPrimary Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]

  @@index([userId, updatedAt])
  @@index([userId, isPrimary])
}

/// Message d'un fil. `userId` est VOLONTAIREMENT redondant avec `thread.userId` :
/// il permet de filtrer par propriétaire sans jointure et rend une fuite de données
/// structurellement impossible, même en cas d'erreur de requête.
model AssistantMessage {
  id        String          @id @default(cuid())
  threadId  String
  thread    AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  role      String /// « user » ou « assistant »
  content   String
  createdAt DateTime        @default(now())

  @@index([threadId, createdAt])
  @@index([userId])
}

/// ═══════════════════════════════════════════════════════════════════════════════════════════
/// UN ÉPISODE — une TRANCHE de conversation, compressible par étapes (§92-94).
///
/// Trois objets de mémoire coexistent déjà et aucun ne fait ce travail : `AssistantMemory` est
/// UN résumé par personne (il ne distingue pas mars d'hier), `AssistantMemoryItem` porte des
/// faits DURABLES qui ne vieillissent pas, et `AssistantMessage` garde les tours bruts — les
/// renvoyer tous à chaque fois est précisément ce que §90 proscrit.
///
/// L'épisode est daté, borné, et sa FIDÉLITÉ décroît avec l'âge sans jamais perdre ce qui
/// compte. Un résumé qui a perdu l'identifiant d'un marché ou le montant d'une facture a
/// détruit exactement ce qu'on voulait garder.
/// ═══════════════════════════════════════════════════════════════════════════════════════════
model AssistantEpisode {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("AssistantEpisodes", fields: [userId], references: [id], onDelete: Cascade)
  threadId      String?
  /// RICH | STRUCTURED | FACTS — la fidélité actuelle, qui ne remonte jamais.
  fidelity      String   @default("RICH")
  summary       String   @db.Text
  /// CE QUI SURVIT À TOUTES LES COMPRESSIONS (§94).
  entities      Json     @default("[]")
  decisions     Json     @default("[]")
  commitments   Json     @default("[]")
  openQuestions Json     @default("[]")
  corrections   Json     @default("[]")
  fromMessageId String?
  toMessageId   String?
  turns         Int      @default(0)
  tokensBefore  Int      @default(0)
  tokensAfter   Int      @default(0)
  startedAt     DateTime
  endedAt       DateTime
  compactedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, fromMessageId, toMessageId])
  @@index([userId, endedAt])
  @@index([threadId, endedAt])
  @@index([userId, fidelity])
}

/// MÉMOIRE DISTILLÉE d'une personne : ce que l'assistant retient d'elle sur la durée
/// (habitudes, dossiers récurrents, préférences), régénéré à partir de ses conversations.
/// Une ligne par compte, jamais partagée.
model AssistantMemory {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation("AssistantMemory", fields: [userId], references: [id], onDelete: Cascade)
  summary   String
  turns     Int      @default(0) /// nombre de messages pris en compte lors de la dernière distillation
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// UNE MÉMOIRE TYPÉE ET DURABLE du Chief of Staff — ce qu'une personne lui a demandé de retenir
/// (« retiens que Pembro = Pembrolizumab »), ou ce qui mérite de l'être : préférences, style de
/// travail, terminologie, ALIAS d'entités, principes exécutifs. Strictement personnelle.
/// ⚠️ La mémoire n'est JAMAIS la source de vérité d'une donnée métier (salaire, stock, statut…) :
/// elle oriente la recherche et le ton, les chiffres se relisent toujours à la source.
/// ACTION INTENT — l'état CANONIQUE d'une action proposée par l'assistant, machine d'état
/// SERVEUR unique : PROPOSED → CONFIRMED → EXECUTING → EXECUTED (ou FAILED / CANCELLED /
/// EXPIRED). Ni l'UI ni le modèle n'inventent un statut : « est-ce que c'est envoyé ? » et
/// « est-ce que je te l'avais déjà demandé ? » se répondent ICI, pas depuis le transcript.
/// Invitation de compte : la personne définit SON mot de passe via un lien à usage unique —
/// aucun mot de passe ne transite (ni conversation, ni administrateur). Compte inconnectable
/// (hash aléatoire) tant que le lien n'est pas consommé.
model UserInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  userId      String
  user        User      @relation("UserInvites", fields: [userId], references: [id], onDelete: Cascade)
  /// Qui a émis l'invitation (traçabilité) — simple id, l'audit porte le détail.
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model AssistantActionIntent {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("AssistantActionIntents", fields: [userId], references: [id], onDelete: Cascade)
  /// AssistantActionKind (registre ACTION_POLICY) — le type d'action.
  kind          String
  module        String
  /// Titre de la carte (« Envoyer un message à Khaled »).
  title         String
  /// Résumé mémorisable : cible + objet (« Notification à Redouane — rattacher les contrats »).
  summary       String
  /// La charge utile exacte, revérifiée côté serveur à l'exécution.
  payload       Json
  /// PROPOSED | CONFIRMED | EXECUTING | EXECUTED | FAILED | CANCELLED | EXPIRED
  status        String    @default("PROPOSED")
  /// D'où l'intention vient : text | voice | nudge.
  origin        String    @default("text")
  level         String? // SENSITIVE | CRITICAL
  /// CRITICAL uniquement : la valeur exacte que l'utilisateur doit RESSAISIR — vérifiée PAR LE SERVEUR à l'exécution.
  confirmText   String?
  resultMessage String?
  resultLink    String?
  error         String?
  /// Journal des transitions [{ status, at }] — l'historique d'autorisation, traçable.
  events        Json      @default("[]")
  proposedAt    DateTime  @default(now())
  decidedAt     DateTime?
  executedAt    DateTime?
  /// LA CLÉ D'IDEMPOTENCE (§15) — unique EN BASE, donc garantie par la base et non par la
  /// discipline de l'appelant. Elle protège le cas que la réclamation atomique ne couvre pas :
  /// une mission qui meurt ENTRE la création de l'intent et son exécution, et dont la reprise
  /// ignorerait l'existence du premier. Reste `null` pour les actions de conversation.
  idempotencyKey String?  @unique
  /// La mission qui a produit cette action, quand il y en a une. Sert à l'historique et à
  /// l'écran : « quelle action a produit ce reçu ? » se répond sans parcourir tous les intents.
  missionId     String?

  @@index([userId, proposedAt])
  @@index([userId, status])
  @@index([missionId])
}

model AssistantMemoryItem {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("AssistantMemoryItems", fields: [userId], references: [id], onDelete: Cascade)
  /// USER_PREFERENCE | WORKING_STYLE | TERMINOLOGY | ENTITY_ALIAS | STRATEGIC_PRIORITY |
  /// RECURRING_INTEREST | REPORTING_PREFERENCE | ORGANIZATIONAL_CONTEXT | EXECUTIVE_PRINCIPLE
  type           String
  /// La mémoire, en une phrase lisible (c'est elle qui est réinjectée au modèle).
  content        String
  /// Détail structuré quand il existe — ex. { alias: "pembro", target: "Pembrolizumab" }.
  structuredData Json?
  confidence     Float     @default(0.8)
  sourceThreadId String?
  active         Boolean   @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, active])
  @@index([userId, type])
}

/// LE REGISTRE DES DÉCISIONS EXÉCUTIVES — « on choisit le fournisseur B » mérite d'être retrouvable
/// six mois plus tard avec son contexte, ses options, son attendu… et son RÉSULTAT RÉEL.
/// Enregistrer une décision n'exécute JAMAIS ses conséquences. Une bonne décision peut produire
/// un mauvais résultat : les deux se jugent séparément (qualité au moment T vs outcome).
model ExecutiveDecision {
  id              String    @id @default(cuid())
  ownerId         String
  owner           User      @relation("ExecutiveDecisions", fields: [ownerId], references: [id], onDelete: Cascade)
  title           String
  context         String?
  problem         String?
  options         Json?
  recommendation  String?
  decision        String?
  /// PROPOSED | DECIDED | REVIEWED | ABANDONED
  status          String    @default("DECIDED")
  decidedAt       DateTime?
  expectedOutcome String?
  reviewDate      DateTime?
  actualOutcome   String?
  lessonsLearned  String?
  /// Entités concernées (références lisibles : PAY-…, fournisseur, produit…).
  entities        Json?
  sourceThreadId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([ownerId, status])
  @@index([reviewDate])
}

/// UN ENGAGEMENT — « le fournisseur X livrera le 15 », « Nesrine rend le rapport vendredi ».
/// Détecté dans la conversation (CR, e-mail lu, réunion) et ENREGISTRÉ par l'assistant sur
/// proposition — jamais suivi d'une relance automatique sans autorisation : un engagement en
/// retard se VOIT (alerte au propriétaire), il ne déclenche rien tout seul.
model ExecutiveCommitment {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation("ExecutiveCommitments", fields: [ownerId], references: [id], onDelete: Cascade)
  /// QUI a promis (personne, fournisseur, équipe) — libre : beaucoup d'engageants n'ont pas de compte.
  who           String
  toWhom        String?
  what          String
  relatedEntity String?
  relatedRef    String?
  promisedAt    DateTime?
  dueAt         DateTime?
  /// D'où vient l'engagement (e-mail du …, CR de réunion, conversation) — la preuve.
  source        String?
  /// OPEN | DONE | BROKEN | CANCELLED
  status        String    @default("OPEN")
  evidence      String?
  /// LA MISSION QUI L'A CRÉÉ — sans ce lien, une réponse de Redouane ne peut pas réveiller la
  /// bonne branche du DAG (§86, §103).
  missionId     String?
  mission       Mission?  @relation("MissionCommitments", fields: [missionId], references: [id], onDelete: SetNull)
  stepKey       String?
  /// L'identité canonique de l'engageant, quand il en a une. `who` reste le libellé libre :
  /// beaucoup d'engageants (fournisseurs, partenaires) n'ont pas de compte.
  personId      String?
  lastNudgeAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ownerId, status])
  @@index([dueAt])
  @@index([missionId])
  @@index([personId, status])
}

/// REGISTRE DES LIVRABLES fabriqués par l'assistant (rapports Word, classeurs Excel,
/// présentations PowerPoint). La SPEC — le contenu STRUCTURÉ du document — est conservée :
/// c'est elle qui permet de re-générer, de décliner en un autre format avec LES MÊMES
/// chiffres (cohérence inter-fichiers par construction), et de versionner. Les fichiers
/// eux-mêmes vivent dans le Drive du propriétaire (dossier « Livrables IA »).
model AssistantArtifact {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("AssistantArtifacts", fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  /// Formats produits à la dernière génération — « DOCX », « DOCX+XLSX+PPTX »…
  formats   String
  /// Le contenu structuré (sections, tableaux, sources) — la source unique des rendus.
  spec      Json
  version   Int      @default(1)
  /// [{ format, filename, nodeId }] — les fichiers déposés au Drive.
  files     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
}

/// Point du matin de l'assistant : un texte par personne et par jour (fuseau d'Alger).
/// Cache indispensable — sans lui, chaque ouverture de la page relancerait un appel IA.
/// Strictement personnel, comme le reste de la mémoire de l'assistant.
model DailyBrief {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("DailyBriefs", fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  text      String
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
}

/// État d'un envoi de courrier « smart » (API HTTPS, pas de SMTP).
enum OutboundEmailStatus {
  QUEUED /// accepté, pas encore transmis au fournisseur
  SENT /// accepté par le fournisseur (identifiant retourné)
  FAILED /// refusé — le motif exact est conservé
}

/// COURRIER SORTANT — journal de tous les e-mails envoyés par la plateforme.
/// L'envoi passe par l'API HTTPS d'un fournisseur (port 443, jamais 25/465/587) : c'est ce
/// qui met fin aux blocages SMTP. Chaque envoi laisse une trace consultable, avec le motif
/// exact en cas de refus — on ne se demande plus « est-ce parti ? ».
model OutboundEmail {
  id         String              @id @default(cuid())
  userId     String? /// demandeur (null = envoi système)
  user       User?               @relation("OutboundEmails", fields: [userId], references: [id], onDelete: SetNull)
  toAddress  String /// destinataires, séparés par « , »
  ccAddress  String?
  subject    String
  body       String
  isHtml     Boolean             @default(false)
  status     OutboundEmailStatus @default(QUEUED)
  provider   String? /// resend | postmark | brevo
  providerId String? /// identifiant du message chez le fournisseur
  error      String?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())
  sentAt     DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// COURRIER ENTRANT — messages reçus par webhook (le fournisseur pousse, on ne relève pas
/// de boîte IMAP). La signature du fournisseur est vérifiée AVANT toute écriture.
model InboundEmail {
  id          String   @id @default(cuid())
  provider    String
  messageId   String?  @unique /// identifiant du fournisseur — garantit l'idempotence des relivraisons
  fromAddress String
  fromName    String?
  toAddress   String
  subject     String
  text        String
  receivedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([toAddress, receivedAt])
}

/// Stade de diffusion d'une nouveauté.
enum FeatureStage {
  TEST /// visible UNIQUEMENT des comptes en mode test
  PROD /// validée : active pour tout le monde
  OFF /// désactivée (ni test ni production)
}

/// DRAPEAU DE VERSION — chaque nouveauté livrée arrive au stade TEST : elle n'est visible
/// que des comptes en « mode test ». L'administrateur la valide depuis /admin/versions et
/// elle passe en PROD pour tout le monde. Le retour arrière est toujours possible.
/// Le catalogue s'auto-alimente : un drapeau inconnu est créé au premier appel (stade TEST).
model FeatureFlag {
  id           String       @id @default(cuid())
  key          String       @unique
  label        String
  description  String?
  stage        FeatureStage @default(TEST)
  promotedAt   DateTime?
  promotedById String?
  promotedBy   User?        @relation("FeaturePromoter", fields: [promotedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([stage])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(VIEWER)
  // « Autre rôle » (fonction secondaire) réglé par le Super Admin : ex. un délégué qui
  // est AUSSI National Sales / Direction Marketing. Il CUMULE les capacités du rôle
  // principal ET du rôle secondaire (cf. getAccess + hasRole).
  secondaryRole UserRole?
  title         String? // job title
  phone         String?
  avatarColor   String? // UI accent for the avatar chip
  isActive      Boolean   @default(true)
  region        String? // for medical delegates / sales
  lastLoginAt   DateTime?
  lastSeenAt    DateTime? // présence messagerie (heartbeat) : « en ligne / actif il y a… »
  // Statut messagerie choisi manuellement (façon Teams) : AVAILABLE | BUSY | DND | BRB | AWAY |
  // OFFLINE (null = automatique selon la présence). `statusMessage` = message perso court.
  chatStatus    String?
  statusMessage String?

  // Auth hardening: bump tokenVersion to invalidate all existing JWTs;
  // force a password change on next login.
  tokenVersion       Int     @default(0)
  mustChangePassword Boolean @default(false)

  /// COMPTE SYSTÈME — Adam, l'agent principal. Il EXISTE dans l'ERP (missions, livrables,
  /// messages, journal, rôle SUPER_ADMIN) et ne peut PAS s'y connecter : `authorize()` refuse
  /// un compte système avant même de comparer un mot de passe, et les opérations de compte
  /// refusent de le prendre pour cible.
  ///
  /// C'est ce qui réconcilie « donne-lui les accès complets » et « pas de compte humain avec un
  /// mot de passe que l'agent peut manipuler » : la présence sans la porte d'entrée. Adam agit
  /// par le Mission Runtime, sous double signature (qui a demandé / qui a exécuté), avec les
  /// mêmes approbations et le même audit que l'écran.
  isSystem           Boolean @default(false)

  // Onboarding guidé : déclenché à la création d'un compte ou redéclenché par le
  // Super Admin (« demander le setup à la prochaine connexion »). Vérifié à chaud
  // (lecture BDD) par le layout, jamais via le JWT — pas de re-login nécessaire.
  mustOnboard Boolean   @default(false)
  /// MODE TEST : la personne voit les nouveautés encore en phase de test (drapeaux
  /// `FeatureFlag` au stade TEST). Réservé à l'administration — tout le monde voit
  /// la production. Voir src/lib/features.ts.
  testMode    Boolean   @default(false)
  onboardedAt DateTime?

  // Score d'adoption (snapshot mis en cache) — affiché en pastille dans la barre du
