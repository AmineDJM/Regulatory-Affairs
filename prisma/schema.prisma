enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  UPLOAD
  VALIDATE
  REFUSE
}

// ───────────────────────────── Core / identity ─────────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(VIEWER)
  title        String? // job title
  phone        String?
  avatarColor  String? // UI accent for the avatar chip
  isActive     Boolean   @default(true)
  region       String? // for medical delegates / sales
  lastLoginAt  DateTime?

  // Auth hardening: bump tokenVersion to invalidate all existing JWTs;
  // force a password change on next login.
  tokenVersion       Int     @default(0)
  mustChangePassword Boolean @default(false)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Functional relations (drive row-level access)
  regulatoryAsResponsible RegulatoryProduct[] @relation("RegulatoryResponsible")
  regulatoryAsAssistant   RegulatoryProduct[] @relation("RegulatoryAssistant")
  assignedRegulatory      RegulatoryProduct[] @relation("RegulatoryAssignedUsers")
  sponsoringRequests      SponsoringRequest[]
  sales                   Sale[]
  doctors                 MedicalDoctor[]
  visits                  MedicalVisit[]
  delegatePlans           MedicalDelegatePlan[]
  bdOpportunities         BusinessDevelopmentOpportunity[]
  budgetLines             BudgetLine[]
  logisticsOrders         LogisticsOrder[]

  notifications Notification[]
  auditLogs     AuditLog[]
  comments      Comment[]
  documents     Document[]

  // Admin-managed dynamic access + activity + sessions
  access       UserAccess[]
  rowGrants    RowGrant[]
  sessions     UserSession[]
  activityLogs ActivityLog[]

  @@index([role])
  @@index([departmentId])
}

// ───────────────────────────── Regulatory ─────────────────────────────

model RegulatoryProduct {
  custom Json? // admin-defined dynamic fields
  id                String           @id @default(cuid())
  reference         String           @unique // human readable ID, e.g. REG-2026-001
  dci               String // molecule / active ingredient
  brandName         String? // nom commercial envisagé
  dosage            String?
  pharmaceuticalForm String?
  therapeuticClass  String?
  partnerLab        String? // fournisseur / laboratoire partenaire
  countryOfOrigin   String?
  productType       ProductType      @default(IMPORTED)
  status            RegulatoryStatus @default(PRE_SUBMISSION)
  priority          Priority         @default(MEDIUM)
  targetDate        DateTime? // date cible d'enregistrement
  comments          String?

  responsibleId String?
  responsible   User?   @relation("RegulatoryResponsible", fields: [responsibleId], references: [id])
  assistantId   String?
  assistant     User?   @relation("RegulatoryAssistant", fields: [assistantId], references: [id])
  // Row-level access: only these users (plus privileged roles) see the line.
  assignedUsers User[]  @relation("RegulatoryAssignedUsers")

  steps RegulatoryStep[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([responsibleId])
  @@index([assistantId])
  @@index([dci])
}

model RegulatoryStep {
  id          String             @id @default(cuid())
  productId   String
  product     RegulatoryProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        RegulatoryStepType
  order       Int
  status      StepStatus         @default(NOT_STARTED)
  plannedDate DateTime?
  actualDate  DateTime?
  responsible String?
  comment     String?
  missingDocs String? // pièces manquantes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, type])
  @@index([productId])
  @@index([status])
}

// ───────────────────────────── Sponsoring ─────────────────────────────

model SponsoringRequest {
  custom Json? // admin-defined dynamic fields
  id                  String           @id @default(cuid())
  reference           String           @unique
  requestDate         DateTime         @default(now())
  requesterId         String?
  requester           User?            @relation(fields: [requesterId], references: [id])
  institution         String // institution / service / association
  doctor              String? // médecin concerné
  specialty           String?
  city                String?
  type                String // type de sponsoring
  description         String?
  amountRequested     Decimal?         @db.Decimal(12, 2)
  amountProposed      Decimal?         @db.Decimal(12, 2)
  amountGranted       Decimal?         @db.Decimal(12, 2)
  status              SponsoringStatus @default(RECEIVED)
  strategicImportance Priority         @default(MEDIUM)
  product             String? // produit concerné
  expectedRoi         String?
  finalDecision       String?
  validatedBy         String?
  validationDate      DateTime?
  comments            String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([strategicImportance])
  @@index([requesterId])
}

// ───────────────────────────── Budgets ─────────────────────────────

model BudgetLine {
  custom Json? // admin-defined dynamic fields
  id              String         @id @default(cuid())
  year            Int
  month           Int? // 1-12, null = annual line
  department      BudgetCategory
  label           String // ligne budgétaire
  initialBudget   Decimal        @default(0) @db.Decimal(14, 2)
  consumedBudget  Decimal        @default(0) @db.Decimal(14, 2)
  futureCommitted Decimal        @default(0) @db.Decimal(14, 2)
  status          BudgetStatus   @default(ON_TRACK)
  comments        String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@index([department])
  @@index([status])
}

// ───────────────────────────── Congresses ─────────────────────────────

model CongressInternational {
  custom Json? // admin-defined dynamic fields
  id                String         @id @default(cuid())
  name              String
  country           String?
  city              String?
  startDate         DateTime?
  endDate           DateTime?
  specialty         String?
  participants      String? // participants Adventum
  invitedDoctors    String?
  products          String?
  plannedBudget     Decimal?       @db.Decimal(14, 2)
  actualBudget      Decimal?       @db.Decimal(14, 2)
  status            CongressStatus @default(CONSIDERED)
  hotel             String?
  flight            String?
  visa              String?
  registration      String?
  linkedSponsoring  String?
  postEventReport   String?
  generatedLeads    String? // opportunités générées

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([startDate])
}

model CongressNational {
  custom Json? // admin-defined dynamic fields
  id               String         @id @default(cuid())
  name             String
  city             String?
  hostInstitution  String? // hôpital / association
  date             DateTime?
  specialty        String?
  presentDoctors   String?
  promotedProducts String?
  budget           Decimal?       @db.Decimal(14, 2)
  hasBooth         Boolean        @default(false)
  hasSymposium     Boolean        @default(false)
  linkedSponsoring String?
  presentDelegates String?
  status           CongressStatus @default(CONSIDERED)
  finalReport      String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([date])
}

// ───────────────────────────── Sales ─────────────────────────────

model Sale {
  custom Json? // admin-defined dynamic fields
  id               String        @id @default(cuid())
  date             DateTime      @default(now())
  product          String
  dci              String?
  dosage           String?
  pharmaceuticalForm String?
  client           String
  institution      String?
  isPch            Boolean       @default(false)
  quantity         Int           @default(0)
  unitPrice        Decimal       @default(0) @db.Decimal(12, 2)
  revenue          Decimal       @default(0) @db.Decimal(14, 2)
  estimatedMargin  Decimal?      @db.Decimal(14, 2)
  purchaseOrder    String?
  invoice          String?
  paymentStatus    PaymentStatus @default(UNPAID)
  deliveryStatus   DeliveryStatus @default(PENDING)
  comment          String?

  salesUserId String?
  salesUser   User?   @relation(fields: [salesUserId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([product])
  @@index([client])
  @@index([salesUserId])
}

// ───────────────────────────── Logistics PCH ─────────────────────────────

model LogisticsOrder {
  custom Json? // admin-defined dynamic fields
  id                 String          @id @default(cuid())
  reference          String          @unique
  product            String
  dci                String?
  dosage             String?
  pharmaceuticalForm String?
  supplier           String?
  country            String?
  quantityOrdered    Int             @default(0)
  quantityReceived   Int             @default(0)
  quantityDelivered  Int             @default(0)
  orderDate          DateTime?
  estimatedDeparture DateTime?
  actualDeparture    DateTime?
  estimatedArrival   DateTime?
  actualArrival      DateTime?
  customsDate        DateTime?
  pchDeliveryDate    DateTime?
  status             LogisticsStatus @default(ORDERED)
  carrier            String?
  incoterm           String?
  invoiceNumber      String?
  blAwbNumber        String?
  orderValue         Decimal?        @db.Decimal(14, 2)
  currency           String          @default("EUR")
  exchangeRate       Decimal?        @db.Decimal(10, 4)
  comments           String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([estimatedArrival])
  @@index([supplier])
}

// ───────────────────────────── Medical promotion ─────────────────────────────

model MedicalDoctor {
  custom Json? // admin-defined dynamic fields
  id                  String         @id @default(cuid())
  name                String
  specialty           String?
  institution         String? // hôpital / clinique
  city                String?
  region              String?
  phone               String?
  email               String?
  influenceLevel      InfluenceLevel @default(MEDIUM)
  prescriptionPotential Priority     @default(MEDIUM)
  targetProducts      String?
  lastVisit           DateTime?
  nextVisit           DateTime?
  comments            String?

  // Row-level access: a delegate only sees their own doctors.
  delegateId String?
  delegate   User?   @relation(fields: [delegateId], references: [id])

  visits MedicalVisit[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([delegateId])
  @@index([region])
  @@index([city])
}

model MedicalVisit {
  custom Json? // admin-defined dynamic fields
  id              String      @id @default(cuid())
  date            DateTime
  doctorId        String?
  doctor          MedicalDoctor? @relation(fields: [doctorId], references: [id])
  delegateId      String?
  delegate        User?       @relation(fields: [delegateId], references: [id])
  region          String?
  objective       String?
  presentedProducts String?
  status          VisitStatus @default(PLANNED)
  report          String? // compte rendu
  doctorFeedback  String?
  followUpActions String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([delegateId])
  @@index([doctorId])
  @@index([status])
  @@index([date])
}

model MedicalDelegatePlan {
  id              String   @id @default(cuid())
  delegateId      String?
  delegate        User?    @relation(fields: [delegateId], references: [id])
  weekStart       DateTime
  region          String?
  visitsTarget    Int      @default(0)
  keyDoctorsTarget Int     @default(0)
  productTarget   String?
  achievedVisits  Int      @default(0)
  managerComment  String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([delegateId])
  @@index([weekStart])
}

// ───────────────────────────── Business development ─────────────────────────────

model BusinessDevelopmentOpportunity {
  custom Json? // admin-defined dynamic fields
  id               String   @id @default(cuid())
  name             String
  dci              String?
  therapeuticClass String?
  type             BDType   @default(GENERIC)
  targetMarket     String?
  estimatedMarketSize Decimal? @db.Decimal(16, 2)
  estimatedPrice   Decimal? @db.Decimal(12, 2)
  competitors      String?
  potentialSupplier String?
  supplierCountry  String?
  supplierContact  String?
  status           BDStatus @default(IDEA)
  priority         Priority @default(MEDIUM)
  score            Int? // 0-100 opportunity scoring
  nextAction       String?
  nextActionDate   DateTime?
  comments         String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([ownerId])
}

// ───────────────────────────── Cross-cutting ─────────────────────────────

model Document {
  id              String           @id @default(cuid())
  name            String
  category        DocumentCategory @default(OTHER)
  entityType      EntityType
  entityId        String
  fileKey         String? // storage object key (S3/R2/Supabase)
  mimeType        String?
  sizeBytes       Int?
  version         Int              @default(1)
  confidentiality Confidentiality  @default(INTERNAL)
  uploadedById    String?
  uploadedBy      User?            @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([category])
  @@index([uploadedById])
}

model Comment {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  body       String
  authorId   String?
  author     User?      @relation(fields: [authorId], references: [id])
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERIC)
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  action     AuditAction
  module     String // human-readable module name
  entityType EntityType?
  entityId   String?
  field      String? // changed field (for UPDATE)
  oldValue   String?
  newValue   String?
  summary    String? // human readable description
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────────────────────── Dynamic access control ─────────────────────────

enum AccessScope {
  ALL // sees every row of the module
  ASSIGNED // sees only rows explicitly granted / owned
}

/// Per-user, per-module access override. When a row exists it fully replaces the
/// role default for that module, so an admin can grant/revoke a tab and tune
/// exactly which actions a user may perform.
model UserAccess {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      String // Module key (REGULATORY, SALES, …)
  canView     Boolean     @default(true)
  canCreate   Boolean     @default(false)
  canUpdate   Boolean     @default(false)
  canDelete   Boolean     @default(false)
  canValidate Boolean     @default(false)
  canExport   Boolean     @default(false)
  canUpload   Boolean     @default(false)
  scope       AccessScope @default(ASSIGNED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, module])
  @@index([userId])
}

/// Explicit grant of a single row (line) to a user. Combined with UserAccess
/// scope = ASSIGNED, this lets the admin hand-pick which lines a user can see.
model RowGrant {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType EntityType
  entityId   String
  createdAt  DateTime   @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType])
}

// ───────────────────────── Sessions & activity ─────────────────────────

/// A revocable session. The JWT carries this row's `id`; server-side checks
/// reject revoked/expired sessions, giving the admin real token control.
model UserSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  country   String?
  city      String?
  device    String?
  browser   String?
  os        String?
  userAgent String?
  createdAt DateTime  @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([revokedAt])
}

/// Fine-grained activity: page views, logins, and time-on-page (from a client
/// beacon), enriched with device, IP and geolocation.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type       String // PAGE_VIEW | LOGIN | LOGOUT
  path       String?
  module     String?
  durationMs Int? // time spent on the page
  ipAddress  String?
  country    String?
  city       String?
  region     String?
  device     String? // desktop | mobile | tablet
  browser    String?
  os         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
  @@index([path])
}


// ───────────────────────── Custom fields (dynamic columns) ─────────────────────────

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

/// Admin-defined extra field for a module. Values are stored in each record's
/// `custom` JSON column keyed by `key`.
model CustomFieldDef {
  id         String          @id @default(cuid())
  entityType EntityType
  key        String // machine key used inside the record's `custom` JSON
  label      String
  type       CustomFieldType @default(TEXT)
  options    String? // comma-separated choices for SELECT
  order      Int             @default(0)
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([entityType, key])
  @@index([entityType])
}

// ───────────────────────────── Finances ─────────────────────────────

enum FinanceDirection {
  IN // encaissement (recette, apport, prêt reçu)
  OUT // décaissement (dépense, salaire, remboursement)
}

enum FinanceCategory {
  RECETTE // recette / vente / encaissement client
  CCA // compte courant associé (apport)
  PRET // emprunt reçu
  REMBOURSEMENT // remboursement d'emprunt
  SALAIRE // charges de personnel / paie
  LOYER
  VOYAGE // déplacements, missions
  EVENEMENT // table ronde, congrès, sponsoring payé
  BUREAUTIQUE // bureautique, mobilier, matériel
  FOURNISSEUR // achats fournisseurs / marchandises
  CHARGES // charges diverses (élec, eau, internet, assurance)
  IMPOT // impôts & taxes
  BANQUE // frais bancaires
  AUTRE
}

enum FinanceMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum FinanceStatus {
  PENDING // prévu / à régler
  SETTLED // réalisé (impacte la trésorerie)
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  VALIDATED
  PAID
}

/// General ledger entry — the simplified accounting book + treasury source.
model FinanceTransaction {
  custom      Json?
  id          String           @id @default(cuid())
  reference   String           @unique // FIN-2026-001
  date        DateTime         @default(now())
  direction   FinanceDirection
  category    FinanceCategory
  label       String
  amount      Decimal          @db.Decimal(14, 2)
  method      FinanceMethod    @default(BANK_TRANSFER)
  account     String           @default("Banque") // Caisse, Banque, …
  counterparty String? // client / fournisseur / bénéficiaire
  invoiceRef  String?
  status      FinanceStatus    @default(SETTLED)
  notes       String?

  employeeId  String?
  employee    Employee?        @relation(fields: [employeeId], references: [id])

  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([date])
  @@index([direction])
  @@index([category])
  @@index([status])
  @@index([account])
}

/// Employee record for payroll.
model Employee {
  custom     Json?
  id         String   @id @default(cuid())
  fullName   String
  position   String?
  department String?
  email      String?
  phone      String?
  iban       String?
  baseSalary Decimal  @default(0) @db.Decimal(12, 2)
  hireDate   DateTime?
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payrolls     PayrollEntry[]
  transactions FinanceTransaction[]

  @@index([isActive])
}

/// Monthly payslip. When PAID it links to a FinanceTransaction (treasury OUT).
model PayrollEntry {
  id         String        @id @default(cuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  gross      Decimal       @default(0) @db.Decimal(12, 2)
  bonuses    Decimal       @default(0) @db.Decimal(12, 2)
  deductions Decimal       @default(0) @db.Decimal(12, 2)
  net        Decimal       @default(0) @db.Decimal(12, 2)
  status     PayrollStatus @default(DRAFT)
  paidDate   DateTime?
  transactionId String?
  notes      String?
  createdById String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@index([status])
}
