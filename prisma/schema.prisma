  investmentY2 Decimal? @db.Decimal(18, 2)
  investmentY3 Decimal? @db.Decimal(18, 2)
  revenueY1    Decimal? @db.Decimal(18, 2)
  revenueY2    Decimal? @db.Decimal(18, 2)
  revenueY3    Decimal? @db.Decimal(18, 2)

