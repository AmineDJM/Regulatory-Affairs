// ─────────────────────────────────────────────────────────────────────────────
// AMD Internal OS — Prisma schema
// Lightweight internal ERP for Adventum Pharma.
//
// Conventions
//  - Every business model carries audit fields: createdAt, updatedAt,
//    createdById, updatedById (scalar user ids; rich history lives in AuditLog).
//  - Row-level access is driven by explicit ownership/assignment relations
//    (e.g. RegulatoryProduct.assignedUsers, MedicalDoctor.delegate).
//  - Files & comments are polymorphic via (entityType, entityId).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  SUPER_ADMIN
  DIRECTION
  HEAD_OF_REGULATORY
  REGULATORY_ASSISTANT
  HEAD_OF_SALES
  SALES_USER
  LOGISTICS_MANAGER
  MEDICAL_PROMOTION_MANAGER
  MEDICAL_DELEGATE
  BUSINESS_DEVELOPMENT_MANAGER
  FINANCE_BUDGET_MANAGER
  VIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProductType {
  IMPORTED
  LOCALLY_MANUFACTURED
  TOLL_MANUFACTURING // façonnage
  BIOSIMILAR
  GENERIC
  ORIGINATOR // princeps
}

enum RegulatoryStatus {
  PRE_SUBMISSION
  IN_PREPARATION
  SUBMITTED
  AWAITING_BV_PAYMENT
  AWAITING_ANPP
  RESPONDING_TO_QUERIES
  DECISION_OBTAINED
  BLOCKED
  CLOSED
}

enum StepStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  BLOCKED
  LATE
}

enum RegulatoryStepType {
  PRE_SUBMISSION
  CTD_PREPARATION
  DOSSIER_REVIEW
  DOSSIER_SUBMISSION
  BV1_PAYMENT
  BV1_RECEIPT
  BV2_PAYMENT
  BV2_RECEIPT
  BV3_PAYMENT
  BV3_RECEIPT
  QUERY_RESPONSE
  COMPLEMENTS_REQUESTED
  COMPLEMENTS_SUBMITTED
  COMMISSION_REVIEW
  REGISTRATION_DECISION
  AMM_RECEIVED
  DOSSIER_CLOSED
}

enum SponsoringStatus {
  RECEIVED
  IN_ANALYSIS
  ACCEPTED
  REFUSED
  AWAITING_DIRECTION
  PAID
  CLOSED
}

enum BudgetCategory {
  REGULATORY
  SPONSORING
  CONGRESS_INTERNATIONAL
  CONGRESS_NATIONAL
  MEDICAL_PROMOTION
  LOGISTICS
  BUSINESS_DEVELOPMENT
  MARKETING
}

enum BudgetStatus {
  ON_TRACK
  AT_RISK
  OVER_BUDGET
  CLOSED
}

enum CongressStatus {
  CONSIDERED
  VALIDATED
  ORGANIZED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum LogisticsStatus {
  ORDERED
  PRODUCTION
  SHIPPED
  ARRIVED_TERMINAL // arrivé port/aéroport
  CUSTOMS // dédouanement
  DELIVERED
  BLOCKED
}

enum VisitStatus {
  PLANNED
  COMPLETED
  CANCELLED
  POSTPONED
}

enum InfluenceLevel {
  LOW
  MEDIUM
  HIGH
  KEY_OPINION_LEADER
}

enum BDType {
  GENERIC
  BIOSIMILAR
  ORIGINATOR
  LICENSE
  DISTRIBUTION
  TOLL_MANUFACTURING
}

enum BDStatus {
  IDEA
  RESEARCH
  CONTACTED
  NDA
  OFFER_RECEIVED
  NEGOTIATION
  VALIDATED
  ABANDONED
}

enum EntityType {
  REGULATORY_PRODUCT
  REGULATORY_STEP
  SPONSORING
  BUDGET
  CONGRESS_INTERNATIONAL
  CONGRESS_NATIONAL
  SALE
  LOGISTICS
  DOCTOR
  VISIT
  DELEGATE_PLAN
  BD_OPPORTUNITY
}

enum DocumentCategory {
  CTD_FULL
  MODULE_1
  MODULE_2
  MODULE_3
  MODULE_4
  MODULE_5
  GMP_CERTIFICATE
  CPP
  ORIGIN_AMM
  SUBMISSION_LETTER
  BV_RECEIPT
  QUERY_RESPONSE
  REGISTRATION_DECISION
  PROFORMA
  INVOICE
  PACKING_LIST
  BL_AWB
  ANALYSIS_CERTIFICATE
  ORIGIN_CERTIFICATE
  CUSTOMS_DOCS
  DELIVERY_NOTE
  RECEPTION_REPORT
  REQUEST_LETTER
  PROGRAM
  QUOTE
  CONVENTION
  SUPPORTING_DOC
  PHOTO
  PRESENTATION
  POST_EVENT_REPORT
  SUPPLIER_OFFER
  OTHER
}

enum Confidentiality {
  INTERNAL
  RESTRICTED
  CONFIDENTIAL
}

enum NotificationType {
  DEADLINE_NEAR
  LATE
  ASSIGNMENT
  DOCUMENT_UPLOADED
  VALIDATION_REQUIRED
  BUDGET_EXCEEDED
  PCH_DELAY
  REGULATORY_BLOCKED
  SPONSORING_VALIDATION
  BD_NEXT_ACTION
  MEDICAL_TOUR
  GENERIC
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  UPLOAD
  VALIDATE
  REFUSE
}

// ───────────────────────────── Core / identity ─────────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(VIEWER)
  title        String? // job title
  phone        String?
  avatarColor  String? // UI accent for the avatar chip
  isActive     Boolean   @default(true)
  region       String? // for medical delegates / sales
  lastLoginAt  DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Functional relations (drive row-level access)
  regulatoryAsResponsible RegulatoryProduct[] @relation("RegulatoryResponsible")
  regulatoryAsAssistant   RegulatoryProduct[] @relation("RegulatoryAssistant")
  assignedRegulatory      RegulatoryProduct[] @relation("RegulatoryAssignedUsers")
  sponsoringRequests      SponsoringRequest[]
  sales                   Sale[]
  doctors                 MedicalDoctor[]
  visits                  MedicalVisit[]
  delegatePlans           MedicalDelegatePlan[]
  bdOpportunities         BusinessDevelopmentOpportunity[]
  budgetLines             BudgetLine[]
  logisticsOrders         LogisticsOrder[]

  notifications Notification[]
  auditLogs     AuditLog[]
  comments      Comment[]
  documents     Document[]

  @@index([role])
  @@index([departmentId])
}

// ───────────────────────────── Regulatory ─────────────────────────────

model RegulatoryProduct {
  id                String           @id @default(cuid())
  reference         String           @unique // human readable ID, e.g. REG-2026-001
  dci               String // molecule / active ingredient
  brandName         String? // nom commercial envisagé
  dosage            String?
  pharmaceuticalForm String?
  therapeuticClass  String?
  partnerLab        String? // fournisseur / laboratoire partenaire
  countryOfOrigin   String?
  productType       ProductType      @default(IMPORTED)
  status            RegulatoryStatus @default(PRE_SUBMISSION)
  priority          Priority         @default(MEDIUM)
  targetDate        DateTime? // date cible d'enregistrement
  comments          String?

  responsibleId String?
  responsible   User?   @relation("RegulatoryResponsible", fields: [responsibleId], references: [id])
  assistantId   String?
  assistant     User?   @relation("RegulatoryAssistant", fields: [assistantId], references: [id])
  // Row-level access: only these users (plus privileged roles) see the line.
  assignedUsers User[]  @relation("RegulatoryAssignedUsers")

  steps RegulatoryStep[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([responsibleId])
  @@index([assistantId])
  @@index([dci])
}

model RegulatoryStep {
  id          String             @id @default(cuid())
  productId   String
  product     RegulatoryProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        RegulatoryStepType
  order       Int
  status      StepStatus         @default(NOT_STARTED)
  plannedDate DateTime?
  actualDate  DateTime?
  responsible String?
  comment     String?
  missingDocs String? // pièces manquantes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, type])
  @@index([productId])
  @@index([status])
}

// ───────────────────────────── Sponsoring ─────────────────────────────

model SponsoringRequest {
  id                  String           @id @default(cuid())
  reference           String           @unique
  requestDate         DateTime         @default(now())
  requesterId         String?
  requester           User?            @relation(fields: [requesterId], references: [id])
  institution         String // institution / service / association
  doctor              String? // médecin concerné
  specialty           String?
  city                String?
  type                String // type de sponsoring
  description         String?
  amountRequested     Decimal?         @db.Decimal(12, 2)
  amountProposed      Decimal?         @db.Decimal(12, 2)
  amountGranted       Decimal?         @db.Decimal(12, 2)
  status              SponsoringStatus @default(RECEIVED)
  strategicImportance Priority         @default(MEDIUM)
  product             String? // produit concerné
  expectedRoi         String?
  finalDecision       String?
  validatedBy         String?
  validationDate      DateTime?
  comments            String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([strategicImportance])
  @@index([requesterId])
}

// ───────────────────────────── Budgets ─────────────────────────────

model BudgetLine {
  id              String         @id @default(cuid())
  year            Int
  month           Int? // 1-12, null = annual line
  department      BudgetCategory
  label           String // ligne budgétaire
  initialBudget   Decimal        @default(0) @db.Decimal(14, 2)
  consumedBudget  Decimal        @default(0) @db.Decimal(14, 2)
  futureCommitted Decimal        @default(0) @db.Decimal(14, 2)
  status          BudgetStatus   @default(ON_TRACK)
  comments        String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@index([department])
  @@index([status])
}

// ───────────────────────────── Congresses ─────────────────────────────

model CongressInternational {
  id                String         @id @default(cuid())
  name              String
  country           String?
  city              String?
  startDate         DateTime?
  endDate           DateTime?
  specialty         String?
  participants      String? // participants Adventum
  invitedDoctors    String?
  products          String?
  plannedBudget     Decimal?       @db.Decimal(14, 2)
  actualBudget      Decimal?       @db.Decimal(14, 2)
  status            CongressStatus @default(CONSIDERED)
  hotel             String?
  flight            String?
  visa              String?
  registration      String?
  linkedSponsoring  String?
  postEventReport   String?
  generatedLeads    String? // opportunités générées

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([startDate])
}

model CongressNational {
  id               String         @id @default(cuid())
  name             String
  city             String?
  hostInstitution  String? // hôpital / association
  date             DateTime?
  specialty        String?
  presentDoctors   String?
  promotedProducts String?
  budget           Decimal?       @db.Decimal(14, 2)
  hasBooth         Boolean        @default(false)
  hasSymposium     Boolean        @default(false)
  linkedSponsoring String?
  presentDelegates String?
  status           CongressStatus @default(CONSIDERED)
  finalReport      String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([date])
}

// ───────────────────────────── Sales ─────────────────────────────

model Sale {
  id               String        @id @default(cuid())
  date             DateTime      @default(now())
  product          String
  dci              String?
  dosage           String?
  pharmaceuticalForm String?
  client           String
  institution      String?
  isPch            Boolean       @default(false)
  quantity         Int           @default(0)
  unitPrice        Decimal       @default(0) @db.Decimal(12, 2)
  revenue          Decimal       @default(0) @db.Decimal(14, 2)
  estimatedMargin  Decimal?      @db.Decimal(14, 2)
  purchaseOrder    String?
  invoice          String?
  paymentStatus    PaymentStatus @default(UNPAID)
  deliveryStatus   DeliveryStatus @default(PENDING)
  comment          String?

  salesUserId String?
  salesUser   User?   @relation(fields: [salesUserId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([product])
  @@index([client])
  @@index([salesUserId])
}

// ───────────────────────────── Logistics PCH ─────────────────────────────

model LogisticsOrder {
  id                 String          @id @default(cuid())
  reference          String          @unique
  product            String
  dci                String?
  dosage             String?
  pharmaceuticalForm String?
  supplier           String?
  country            String?
  quantityOrdered    Int             @default(0)
  quantityReceived   Int             @default(0)
  quantityDelivered  Int             @default(0)
  orderDate          DateTime?
  estimatedDeparture DateTime?
  actualDeparture    DateTime?
  estimatedArrival   DateTime?
  actualArrival      DateTime?
  customsDate        DateTime?
  pchDeliveryDate    DateTime?
  status             LogisticsStatus @default(ORDERED)
  carrier            String?
  incoterm           String?
  invoiceNumber      String?
  blAwbNumber        String?
  orderValue         Decimal?        @db.Decimal(14, 2)
  currency           String          @default("EUR")
  exchangeRate       Decimal?        @db.Decimal(10, 4)
  comments           String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([estimatedArrival])
  @@index([supplier])
}

// ───────────────────────────── Medical promotion ─────────────────────────────

model MedicalDoctor {
  id                  String         @id @default(cuid())
  name                String
  specialty           String?
  institution         String? // hôpital / clinique
  city                String?
  region              String?
  phone               String?
  email               String?
  influenceLevel      InfluenceLevel @default(MEDIUM)
  prescriptionPotential Priority     @default(MEDIUM)
  targetProducts      String?
  lastVisit           DateTime?
  nextVisit           DateTime?
  comments            String?

  // Row-level access: a delegate only sees their own doctors.
  delegateId String?
  delegate   User?   @relation(fields: [delegateId], references: [id])

  visits MedicalVisit[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([delegateId])
  @@index([region])
  @@index([city])
}

model MedicalVisit {
  id              String      @id @default(cuid())
  date            DateTime
  doctorId        String?
  doctor          MedicalDoctor? @relation(fields: [doctorId], references: [id])
  delegateId      String?
  delegate        User?       @relation(fields: [delegateId], references: [id])
  region          String?
  objective       String?
  presentedProducts String?
  status          VisitStatus @default(PLANNED)
  report          String? // compte rendu
  doctorFeedback  String?
  followUpActions String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([delegateId])
  @@index([doctorId])
  @@index([status])
  @@index([date])
}

model MedicalDelegatePlan {
  id              String   @id @default(cuid())
  delegateId      String?
  delegate        User?    @relation(fields: [delegateId], references: [id])
  weekStart       DateTime
  region          String?
  visitsTarget    Int      @default(0)
  keyDoctorsTarget Int     @default(0)
  productTarget   String?
  achievedVisits  Int      @default(0)
  managerComment  String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([delegateId])
  @@index([weekStart])
}

// ───────────────────────────── Business development ─────────────────────────────

model BusinessDevelopmentOpportunity {
  id               String   @id @default(cuid())
  name             String
  dci              String?
  therapeuticClass String?
  type             BDType   @default(GENERIC)
  targetMarket     String?
  estimatedMarketSize Decimal? @db.Decimal(16, 2)
  estimatedPrice   Decimal? @db.Decimal(12, 2)
  competitors      String?
  potentialSupplier String?
  supplierCountry  String?
  supplierContact  String?
  status           BDStatus @default(IDEA)
  priority         Priority @default(MEDIUM)
  score            Int? // 0-100 opportunity scoring
  nextAction       String?
  nextActionDate   DateTime?
  comments         String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([ownerId])
}

// ───────────────────────────── Cross-cutting ─────────────────────────────

model Document {
  id              String           @id @default(cuid())
  name            String
  category        DocumentCategory @default(OTHER)
  entityType      EntityType
  entityId        String
  fileKey         String? // storage object key (S3/R2/Supabase)
  mimeType        String?
  sizeBytes       Int?
  version         Int              @default(1)
  confidentiality Confidentiality  @default(INTERNAL)
  uploadedById    String?
  uploadedBy      User?            @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([category])
  @@index([uploadedById])
}

model Comment {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  body       String
  authorId   String?
  author     User?      @relation(fields: [authorId], references: [id])
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERIC)
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  action     AuditAction
  module     String // human-readable module name
  entityType EntityType?
  entityId   String?
  field      String? // changed field (for UPDATE)
  oldValue   String?
  newValue   String?
  summary    String? // human readable description
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
}
