# ─────────────────────────────────────────────────────────────
# AMD Internal OS — Environment configuration (EXAMPLE)
# Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local:    postgresql://postgres:postgres@localhost:5432/amd_internal_os
# Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amd_internal_os?schema=public"

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# File storage (S3-compatible: Supabase Storage / Cloudflare R2 / AWS S3).
# Optional for the MVP — uploads fall back to local/DB metadata when unset.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="amd-documents"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Max upload size in MB (server-enforced).
MAX_UPLOAD_MB="25"

# Optional SMTP for email notifications (internal notifications work without it).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AMD Internal OS <no-reply@adventum.local>"
